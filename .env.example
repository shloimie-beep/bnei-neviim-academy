# Database (Railway provides this automatically)
DATABASE_URL=

# Telegram Bot (academy bot for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_BNA=
TELEGRAM_CHAT_ID_SHLOIMIE=
TELEGRAM_CHAT_ID_AHUVA=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_REPLY_MODE=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
OPENAI_PROJECT=
OPENAI_ORG=

# Optional parent/student portal contact button
RABBI_SHLOIMIE_WHATSAPP_NUMBER=

# Whapi / WAPI WhatsApp integration
WHAPI_API_TOKEN=
WHAPI_API_BASE_URL=https://gate.whapi.cloud
WAPI_WEBHOOK_SECRET=
WAPI_SEND_TIMEOUT_MS=15000
WAPI_SYNC_TIMEOUT_MS=20000

# Autonomous Codex agent fleet
AGENT_FLEET_POLL_MS=60000
AGENT_FLEET_TASK_TIMEOUT_MS=1800000
AGENT_FLEET_VERIFY_TIMEOUT_MS=480000
AGENT_FLEET_MAX_RETRIES=2
AGENT_FLEET_OPENAI_SMOKE=1
# Optional custom verifier commands, separated by newlines or ";;"
AGENT_FLEET_VERIFY_COMMANDS=

# Payment Link (for signup form redirect)
PAYMENT_LINK=

# App URL (your Railway URL)
APP_URL=

# BNA Operations Auth
OPS_USERNAME=
OPS_PASSWORD=

# Optional scoped Operations login for One Time Mishnah Class task workspace only
ONE_TIME_OPS_USERNAME=
ONE_TIME_OPS_PASSWORD=
# Backward-compatible aliases also accepted by the app:
# RABBI_ELIE_SCHELLER_OPS_USERNAME=
# RABBI_ELIE_SCHELLER_OPS_PASSWORD=

# Optional separate Rabbi Elie Scheller Telegram bot profile.
# Start with: npm run telegram:rabbi
# Scope: One Time Mishnah Class task/comment/chat only. Codex execution is off by default.
TELEGRAM_BOT_TOKEN_RABBI_ELIE_SCHELLER=
TELEGRAM_CHAT_ID_RABBI_ELIE_SCHELLER=
RABBI_ELIE_SCHELLER_CODEX_ENABLED=false
# Railway worker-only selector. Leave unset on the web service.
# BNA_RAILWAY_PROCESS=telegram-rabbi

# Google Workspace OAuth / Drive pipeline
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://bneineviimacademy.org/api/google/oauth/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PIPELINE_ROOT_NAME=BNA V2
GOOGLE_DRIVE_PIPELINE_FOLDER_ID=
GOOGLE_DRIVE_PIPELINE_CONFIG=
GOOGLE_SCOPES=https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/documents https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/classroom.courses.readonly https://www.googleapis.com/auth/classroom.rosters.readonly https://www.googleapis.com/auth/classroom.profile.emails https://www.googleapis.com/auth/classroom.topics https://www.googleapis.com/auth/classroom.coursework.students https://www.googleapis.com/auth/classroom.coursework.students.readonly https://www.googleapis.com/auth/classroom.courseworkmaterials https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.events.readonly
# Role-scoped OAuth examples:
# /api/google/oauth/start?role=admin_teacher&features=classroom_manage,calendar_write
# /api/google/oauth/start?role=student&student_id=123
# /api/google/oauth/start?role=parent&parent_email=parent@example.com&features=calendar_write

# Optional server-side YouTube processing for owned/permissioned BNA media only.
# Keep disabled unless yt-dlp is installed/configured on the server.
BNA_YTDLP_ENABLED=false
YTDLP_BINARY=yt-dlp
YTDLP_OUTPUT_DIR=
YTDLP_FFMPEG_LOCATION=

# Buffer social publishing for Facebook, LinkedIn, and YouTube.
# BNA Operations remains first-party; Buffer is only a social scheduler connector.
BUFFER_ACCESS_TOKEN=
BUFFER_ORGANIZATION_ID=
SOCIAL_POST_PROVIDER=buffer

# BNA office email sender (Gmail API, not external CRM campaigns)
GMAIL_FROM=
GMAIL_FROM_NAME=Bnei Neviim Academy Office
