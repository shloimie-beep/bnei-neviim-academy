# BNA local environment example
# Copy to .env.local with: npm run setup:local
# Keep real values only in .env.local, .secrets/, Railway variables, or the BNA keyholder.

# Core app
PORT=8080
HOST=127.0.0.1
BNA_BIND_HOST=127.0.0.1
BNA_KEYHOLDER_DIR=
DATABASE_URL=
APP_URL=http://localhost:8080
BNA_APP_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=
BNA_COOKIE_SECURE=false
BNA_TIME_ZONE=Asia/Jerusalem

# Single-tenant One Time deployment profile.
# Use these only on the separate One Time Railway service/database.
APP_MODE=
APP_INSTANCE=
DEFAULT_WORKSPACE_KEY=
DEFAULT_PROJECT_KEY=
BRAND_KEY=
PUBLIC_LANGUAGE=
STUDENT_BOT_ENABLED=
BNA_ACCOUNTABILITY_ENABLED=
SEFARIA_STUDY_ASSISTANT_ENABLED=

# Operations auth
OPS_USERNAME=
OPS_PASSWORD=
# Optional comma-separated aliases accepted for the super-admin Operations
# login. Useful when OPS_USERNAME is a short private handle but the operator
# naturally types an email address.
OPS_LOGIN_ALIASES=
OPS_ADMIN_EMAIL=
OPS_LOGIN_RATE_LIMIT_WINDOW_MS=600000
OPS_LOGIN_RATE_LIMIT_MAX=10
OPERATOR_BOOTSTRAP_TTL_MS=600000
OPERATOR_BOOTSTRAP_MAX_TTL_MS=900000
OPERATOR_BOOTSTRAP_PASSPHRASE_MIN=20

# One Time / Rabbi scoped Operations auth
# DEPRECATED: ONE_TIME_OPS_USERNAME/PASSWORD still work for backward compatibility
# but map to the manager (Shloimie) role. Prefer the new split below.
ONE_TIME_OPS_USERNAME=
ONE_TIME_OPS_PASSWORD=
# Backward-compatible aliases accepted by the app:
RABBI_ELIE_SCHELLER_OPS_USERNAME=
RABBI_ELIE_SCHELLER_OPS_PASSWORD=

# Two-login architecture: owner (Rabbi Elie Scheller) vs manager (Shloimie)
# Owner gets full provider view + settings; manager gets provider view without admin.
ONE_TIME_OWNER_USERNAME=
ONE_TIME_OWNER_PASSWORD=
ONE_TIME_MANAGER_USERNAME=
ONE_TIME_MANAGER_PASSWORD=
# Aliases for the split login:
RABBI_ELIE_OWNER_USERNAME=
RABBI_ELIE_OWNER_PASSWORD=
SHLOIMIE_ONE_TIME_USERNAME=
SHLOIMIE_ONE_TIME_PASSWORD=

# Studio/task-only worker logins.
ONE_TIME_STUDIO_OPERATOR_USERNAME=
ONE_TIME_STUDIO_OPERATOR_PASSWORD=
ONE_TIME_AI_STUDIO_USERNAME=
ONE_TIME_AI_STUDIO_PASSWORD=
OPENART_STUDIO_OPERATOR_USERNAME=
OPENART_STUDIO_OPERATOR_PASSWORD=
ONE_TIME_AI_VIDEO_WORKER_USERNAME=
ONE_TIME_AI_VIDEO_WORKER_PASSWORD=
# Aliases for the AI video worker:
ONE_TIME_VIDEO_WORKER_USERNAME=
ONE_TIME_VIDEO_WORKER_PASSWORD=
ONE_TIME_STUDIO_VIDEO_WORKER_USERNAME=
ONE_TIME_STUDIO_VIDEO_WORKER_PASSWORD=
ONE_TIME_AI_VIDEO_POLICY_VERSION=2026-07-06-provisional-no-live
ONE_TIME_AI_VIDEO_MODEL_PROVIDER=openart_mcp_pending_oauth
ONE_TIME_AI_VIDEO_MODEL=openart-video-provisional-manual-export-v1
ONE_TIME_AI_VIDEO_MONTHLY_BUDGET_USD=25
ONE_TIME_AI_VIDEO_PER_RENDER_CAP_USD=2
ONE_TIME_AI_VIDEO_MAX_RENDERS_PER_MONTH=10

# Telegram optional vars
TELEGRAM_BRIDGE_PROFILE=bna
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_BNA=
TELEGRAM_BOT_TOKEN_SHLOIMIE=
TELEGRAM_BOT_TOKEN_AHUVA=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_BNA=
TELEGRAM_CHAT_ID_SHLOIMIE=
TELEGRAM_CHAT_ID_AHUVA=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PRIMARY_AGENT=codex
TELEGRAM_DEFAULT_REPLY_MODE=openai
TELEGRAM_DEFAULT_CHAT_MODE=openai
TELEGRAM_API_PRIMARY_PROVIDER=openai
TELEGRAM_ASYNC_AGENT_REPLIES=true
TELEGRAM_TASK_WATCH_INTERVAL_MS=45000
# Useful transition notifications remain off until the private-chat canary passes.
TELEGRAM_TASK_NOTIFICATIONS_ENABLED=false
TELEGRAM_NOTIFICATION_QUIET_START_HOUR=22
TELEGRAM_NOTIFICATION_QUIET_END_HOUR=7
TELEGRAM_NOTIFICATION_RATE_LIMIT_PER_HOUR=6
TELEGRAM_UPLOAD_MAX_BYTES=47185920
TELEGRAM_BOT_TOKEN_RABBI_ELIE_SCHELLER=
TELEGRAM_CHAT_ID_RABBI_ELIE_SCHELLER=
RABBI_ELIE_SCHELLER_TELEGRAM_BOT_TOKEN=
RABBI_ELIE_SCHELLER_TELEGRAM_CHAT_ID=
ONE_TIME_TELEGRAM_CHAT_ID=
RABBI_ELIE_SCHELLER_CODEX_ENABLED=false
# Railway worker-only selector. Leave unset on the web service.
BNA_RAILWAY_PROCESS=
# Sanitized asynchronous summary consumer. Keep false until OT-LIVE-001 ships
# the matching signed producer and replay proof.
BNA_CONTROL_SUMMARY_EVENTS_ENABLED=false

# OpenAI / Kimi optional vars
BNA_AI_PRIMARY_PROVIDER=openai
AI_PRIMARY_PROVIDER=
CONTENT_AI_PRIMARY_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
OPENAI_WEB_SEARCH_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REQUEST_TIMEOUT_MS=600000
OPENAI_WEB_SEARCH_TIMEOUT_MS=600000
OPENAI_PROJECT=
OPENAI_ORG=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.7-code-highspeed
KIMI_CLI_MODEL=kimi-k2.7-code-highspeed
AGENT_FLEET_KIMI_FALLBACK_ENABLED=1
AGENT_FLEET_KIMI_FALLBACK_MODE=quota_only
AGENT_FLEET_KIMI_MODEL=kimi-k2.7-code-highspeed
AGENT_FLEET_KIMI_MAX_STEPS=20
KIMI_BRIDGE_TIMEOUT_MS=240000
CODEX_BRIDGE_TIMEOUT_MS=900000
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=
TRANSCRIPTION_MAX_BYTES=26214400

# Google / Gmail / Drive optional vars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google/oauth/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_PIPELINE_ROOT_NAME=BNA V2
GOOGLE_DRIVE_PIPELINE_FOLDER_ID=
GOOGLE_DRIVE_PIPELINE_CONFIG=
# Start test-user OAuth with identity only. Add feature scopes only for a
# specific approved smoke; do not include Gmail, broad Drive, Classroom rosters,
# guardians, grades, or profile-email scopes by default.
GOOGLE_SCOPES=https://www.googleapis.com/auth/userinfo.email
# Per-smoke scope examples:
# GOOGLE_SCOPE_EXAMPLE_CALENDAR_EVENTS=https://www.googleapis.com/auth/calendar.events
# GOOGLE_SCOPE_EXAMPLE_CALENDAR_OWNED=https://www.googleapis.com/auth/calendar.events.owned
# GOOGLE_SCOPE_EXAMPLE_CALENDAR_APP_CREATED=https://www.googleapis.com/auth/calendar.app.created
# GOOGLE_SCOPE_EXAMPLE_CALENDAR_FREEBUSY=https://www.googleapis.com/auth/calendar.freebusy
# GOOGLE_SCOPE_EXAMPLE_CLASSROOM_COURSES=https://www.googleapis.com/auth/classroom.courses.readonly
# GOOGLE_SCOPE_EXAMPLE_CLASSROOM_MATERIALS=https://www.googleapis.com/auth/classroom.courseworkmaterials
# GOOGLE_SCOPE_EXAMPLE_CLASSROOM_STUDENT_COURSEWORK=https://www.googleapis.com/auth/classroom.coursework.students
# GOOGLE_SCOPE_EXAMPLE_CLASSROOM_TOPICS=https://www.googleapis.com/auth/classroom.topics
# GOOGLE_SCOPE_EXAMPLE_DRIVE_FILE=https://www.googleapis.com/auth/drive.file
# GOOGLE_SCOPE_EXAMPLE_DRIVE_METADATA=https://www.googleapis.com/auth/drive.metadata.readonly
# GOOGLE_SCOPE_EXAMPLE_BUSINESS_PROFILE=https://www.googleapis.com/auth/business.manage
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
DRIVE_WATCH_INTERVAL_MS=10000

