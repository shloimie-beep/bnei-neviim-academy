+async function stampGoalParentReview(client, {
+  goalId,
+  communicationId,
+  accountabilityEventId = null,
+  parentEmail = '',
+  status = 'pending',
+  action = '',
+  response = '',
+  kind = 'goal_checkoff',
+  occurredAt = new Date().toISOString(),
+} = {}) {
+  const id = Number(goalId);
+  if (!Number.isFinite(id)) return null;
+  const goal = await getGoalBoardEvent(id, client);
+  if (!goal) return null;
+
+  const actionStatus = ['approved', 'denied', 'pending'].includes(String(status || '').toLowerCase())
+    ? String(status || '').toLowerCase()
+    : 'pending';
+  const review = {
+    status: actionStatus,
+    action: action || (actionStatus === 'pending' ? 'pending_parent_review' : actionStatus),
+    response: String(response || '').trim(),
+    kind,
+    parent_email: normalizeEmail(parentEmail),
+    communication_id: Number(communicationId) || null,
+    accountability_event_id: Number(accountabilityEventId) || null,
+    created_at: occurredAt,
+    responded_at: actionStatus === 'pending' ? null : occurredAt,
+  };
+  const existingMetadata = parseJsonMaybe(goal.metadata);
+  const previousReviews = Array.isArray(existingMetadata.parent_reviews) ? existingMetadata.parent_reviews : [];
+  let nextMetadata = {
+    ...existingMetadata,
+    parent_review: review,
+    parent_reviews: [review, ...previousReviews].slice(0, 20),
+  };
+  if (actionStatus === 'approved') {
+    nextMetadata = goalBoardMetadataFromPayload({
+      approval_status: 'approved',
+      status: clampProgressPercent(goal.progress_percent) >= 100 ? 'done' : 'active',
+    }, nextMetadata);
+  } else {
+    nextMetadata = goalBoardMetadataFromPayload({
+      approval_required: true,
+      approval_status: actionStatus === 'denied' ? 'denied' : 'pending_review',
+      status: 'waiting',
+      review_reason: actionStatus === 'denied'
+        ? 'Parent denied the student checkoff. Staff review is required.'
+        : 'Parent review is pending after a student checkoff.',
+      goal_board: {
+        consequence: {
+          review_reason: actionStatus === 'denied'
+            ? 'Parent denied the student checkoff. Staff review is required.'
+            : 'Parent review is pending after a student checkoff.',
+        },
+      },
+    }, nextMetadata);
+  }
+
+  const updated = await client.query(
+    `UPDATE bna_accountability_events
+     SET metadata = $2,
+         updated_at = NOW()
+     WHERE id = $1
+       AND event_type = 'student_goal'
+     RETURNING *`,
+    [goal.id, JSON.stringify(nextMetadata)]
+  );
+  return updated.rows[0] || goal;
+}
+
+function parentNotificationBody({ student, goal, kind, message = '', checkoff = {} } = {}) {
+  const lines = [];
+  if (kind === 'student_parent_message') {
+    lines.push(`${student?.name || 'Your child'} sent you a message.`);
+  } else {
+    lines.push(`${student?.name || 'Your child'} checked off ${goal?.title || 'a goal'}.`);
+  }
+  if (checkoff.date) lines.push(`Date: ${checkoff.date}.`);
+  if (checkoff.progress_percent !== undefined && checkoff.progress_percent !== null) {
+    lines.push(`Progress: ${Number(checkoff.progress_percent)}%.`);
+  }
+  if (checkoff.note) lines.push(`Student note: ${checkoff.note}`);
+  if (message) lines.push(message);
+  return lines.filter(Boolean).join('\n');
+}
