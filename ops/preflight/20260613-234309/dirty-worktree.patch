-      model: process.env.KIMI_MODEL?.trim() || DEFAULT_KIMI_MODEL,
-    });
-  }
-
-  const openAiKey = process.env.OPENAI_API_KEY?.trim();
-  if (openAiKey) {
-    providers.push({
