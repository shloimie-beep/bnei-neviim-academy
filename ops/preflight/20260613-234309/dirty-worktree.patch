+function assignmentRfc3339(dateString, hour = 9, minute = 0) {
+  const offset = BNA_TIME_ZONE === 'Asia/Jerusalem' ? '+03:00' : 'Z';
+  return `${assignmentLocalDateTime(dateString, hour, minute)}${offset}`;
+}
+
+function assignmentDateFromLocal(dateString, hour = 9, minute = 0) {
+  return new Date(assignmentRfc3339(dateString, hour, minute));
