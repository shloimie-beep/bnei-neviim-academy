+  };
+}
+
+const PARENT_PERMISSION_FIELDS = [
+  ['leave_premises', 'leave premises'],
+  ['walk_unaccompanied', 'walk/travel unaccompanied'],
+  ['swimming', 'swimming or water activities'],
+  ['buy_food', 'buy food'],
+  ['junk_food', 'junk food/treats'],
+  ['spend_money', 'spend personal money'],
+  ['stay_late', 'stay late'],
+];
+
+function normalizeParentPermissionChoice(value, fallback = 'ask_first') {
+  if (value === true) return 'yes';
+  if (value === false) return 'no';
+  const normalized = String(value || '')
+    .trim()
+    .toLowerCase()
+    .replace(/[\s-]+/g, '_');
+  if (['yes', 'y', 'true', 'allowed', 'allow', 'approved', 'approve', 'ok'].includes(normalized)) return 'yes';
+  if (['no', 'n', 'false', 'not_allowed', 'disallowed', 'deny', 'denied'].includes(normalized)) return 'no';
+  if (['ask', 'ask_first', 'call_parent', 'confirm_first', 'parent_confirm', 'with_permission'].includes(normalized)) return 'ask_first';
+  return fallback;
+}
+
+function normalizeBooleanValue(value) {
+  if (value === true) return true;
+  if (value === false || value === null || value === undefined) return false;
+  return ['true', '1', 'yes', 'y', 'on', 'checked'].includes(String(value).trim().toLowerCase());
+}
+
+function firstPermissionValue(body = {}, key, aliases = []) {
+  const source = body.parent_permissions && typeof body.parent_permissions === 'object'
+    ? body.parent_permissions
+    : {};
+  for (const candidate of [key, `permission_${key}`, `${key}_permission`, ...aliases]) {
+    if (body[candidate] !== undefined && body[candidate] !== '') return body[candidate];
+    if (source[candidate] !== undefined && source[candidate] !== '') return source[candidate];
+  }
+  return undefined;
+}
+
+function buildParentPermissions(body = {}) {
+  const source = body.parent_permissions && typeof body.parent_permissions === 'object'
+    ? body.parent_permissions
+    : {};
+  const permissions = {
+    version: '2026-06-12',
+    leave_premises: normalizeParentPermissionChoice(firstPermissionValue(body, 'leave_premises')),
+    walk_unaccompanied: normalizeParentPermissionChoice(firstPermissionValue(body, 'walk_unaccompanied', ['walk_home', 'walk_home_unaccompanied'])),
+    swimming: normalizeParentPermissionChoice(firstPermissionValue(body, 'swimming', ['swim'])),
+    buy_food: normalizeParentPermissionChoice(firstPermissionValue(body, 'buy_food', ['food'])),
+    junk_food: normalizeParentPermissionChoice(firstPermissionValue(body, 'junk_food', ['treats'])),
+    spend_money: normalizeParentPermissionChoice(firstPermissionValue(body, 'spend_money', ['money'])),
+    stay_late: normalizeParentPermissionChoice(firstPermissionValue(body, 'stay_late')),
+    pickup_responsibility_acknowledged: normalizeBooleanValue(
+      body.pickup_responsibility_acknowledged ?? source.pickup_responsibility_acknowledged
+    ),
+    pickup_dropoff_notes: limitText(body.pickup_dropoff_notes ?? source.pickup_dropoff_notes ?? '', 1200),
+    parent_permission_notes: limitText(body.parent_permission_notes ?? source.parent_permission_notes ?? '', 1200),
+  };
+  return permissions;
+}
+
+function summarizeParentPermissions(permissions = {}) {
+  const lines = PARENT_PERMISSION_FIELDS.map(([key, label]) => {
+    const value = normalizeParentPermissionChoice(permissions[key]);
+    return `${label}: ${value.replace('_', ' ')}`;
+  });
+  lines.push(`parent responsibility notice shown: ${permissions.pickup_responsibility_acknowledged ? 'yes' : 'no'}`);
+  if (permissions.pickup_dropoff_notes) lines.push(`pickup/drop-off notes: ${permissions.pickup_dropoff_notes}`);
+  if (permissions.parent_permission_notes) lines.push(`permission notes: ${permissions.parent_permission_notes}`);
+  return lines.join('; ');
+}
