+  if (!text) return '';
+  const patterns = [
+    /youtu\.be\/([a-zA-Z0-9_-]{6,})/,
+    /youtube\.com\/watch\?[^#]*v=([a-zA-Z0-9_-]{6,})/,
+    /youtube\.com\/shorts\/([a-zA-Z0-9_-]{6,})/,
+    /youtube\.com\/embed\/([a-zA-Z0-9_-]{6,})/,
+    /youtube\.com\/live\/([a-zA-Z0-9_-]{6,})/,
+  ];
+  for (const pattern of patterns) {
+    const match = text.match(pattern);
+    if (match?.[1]) return match[1];
+  }
+  return '';
+}
+
+function isValidYoutubeAssignmentUrl(url) {
+  const text = String(url || '').trim();
+  if (!text) return true;
+  try {
+    const parsed = new URL(text);
+    const host = parsed.hostname.toLowerCase().replace(/^www\./, '');
+    if (host === 'youtu.be') return Boolean(youtubeVideoIdFromUrl(text));
+    if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'music.youtube.com') {
+      return Boolean(youtubeVideoIdFromUrl(text));
+    }
+    return false;
+  } catch {
+    return false;
+  }
+}
+
+async function fetchYoutubeMetadata(url) {
+  const sourceUrl = String(url || '').trim();
+  const videoId = youtubeVideoIdFromUrl(sourceUrl);
+  if (!sourceUrl || !videoId) return {};
+  const base = {
+    provider: 'youtube',
+    video_id: videoId,
+    source_url: sourceUrl,
+    duration_seconds: null,
+    fetched_at: new Date().toISOString(),
+  };
+  try {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 4000);
+    const response = await fetch(`https://www.youtube.com/oembed?url=${encodeURIComponent(sourceUrl)}&format=json`, {
+      signal: controller.signal,
+      headers: { accept: 'application/json' },
+    });
+    clearTimeout(timeout);
+    if (!response.ok) {
+      return { ...base, fetch_status: 'failed', error: `youtube_oembed_${response.status}` };
+    }
+    const data = await response.json();
+    return {
+      ...base,
+      fetch_status: 'ok',
+      metadata_source: 'youtube_oembed',
+      title: data.title || '',
+      channel: data.author_name || '',
+      channel_url: data.author_url || '',
+      thumbnail: data.thumbnail_url || '',
+      width: data.width || null,
+      height: data.height || null,
+    };
+  } catch (err) {
+    return { ...base, fetch_status: 'failed', error: err.name === 'AbortError' ? 'timeout' : err.message };
+  }
+}
+
+function safeMediaFilePart(value) {
+  return String(value || '')
+    .trim()
+    .replace(/[^a-zA-Z0-9_-]+/g, '-')
+    .replace(/^-+|-+$/g, '')
+    .slice(0, 80) || 'youtube';
+}
