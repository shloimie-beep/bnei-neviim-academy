+async function getParentPortalStudentForSession(parentEmail, studentId, db = pool) {
+  const email = normalizeEmail(parentEmail);
+  const result = await db.query(
+    `SELECT DISTINCT s.*
+     FROM bna_students s
+     LEFT JOIN signups su
+       ON su.id = s.signup_id
+       OR (
+         lower(COALESCE(su.student_name, '')) = lower(COALESCE(s.name, ''))
+         AND lower(COALESCE(su.parent_email, '')) = $2
+       )
+     WHERE s.id = $1
+       AND COALESCE(s.status, 'active') NOT IN ('inactive', 'archived')
+       AND (
+         lower(COALESCE(s.parent_email, '')) = $2
+         OR lower(COALESCE(su.parent_email, '')) = $2
+       )
+     LIMIT 1`,
+    [studentId, email]
+  );
+  return result.rows[0] || null;
+}
