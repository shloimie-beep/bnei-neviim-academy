+async function setParentPasswordFromResetToken({ token, password }, db = pool) {
+  const rawPassword = validateParentPassword(password);
+  const tokenHash = sha256Hex(token);
+  const client = db.connect ? await db.connect() : null;
+  const runner = client || db;
+  try {
+    if (client) await client.query('BEGIN');
+    const reset = (await runner.query(
+      `UPDATE bna_parent_password_reset_tokens
+       SET used_at = NOW()
+       WHERE token_hash = $1
+         AND used_at IS NULL
+         AND expires_at > NOW()
+       RETURNING id, parent_email`,
+      [tokenHash]
+    )).rows[0];
+    if (!reset) {
+      const error = new Error('This password reset link is invalid or expired');
+      error.statusCode = 401;
+      throw error;
+    }
+    const email = normalizeEmail(reset.parent_email);
+    const records = await findParentAccessRecords(email, runner);
+    if (!parentAccessEligible(records)) {
+      const error = new Error('No active signup or student is linked to that parent email');
+      error.statusCode = 404;
+      throw error;
+    }
+    await runner.query(
+      `INSERT INTO bna_parent_password_accounts (
+         parent_email, password_hash, password_set_at, updated_at
+       ) VALUES ($1, $2, NOW(), NOW())
+       ON CONFLICT (parent_email) DO UPDATE SET
+         password_hash = EXCLUDED.password_hash,
+         password_set_at = NOW(),
+         updated_at = NOW()`,
+      [email, parentPasswordHash(rawPassword)]
+    );
+    await runner.query(
+      `INSERT INTO bna_contact_communications (
+         contact_type, signup_id, student_id, channel, direction,
+         summary, body, follow_up_required, occurred_at, created_by, source, metadata
+       ) VALUES (
+         COALESCE($1, 'general'), $2, $3, 'other', 'inbound',
+         'Parent portal password set', $4, FALSE, NOW(), 'parent_portal', 'dashboard', $5
+       )`,
+      [
+        records.signups[0]?.id ? 'signup' : records.students[0]?.id ? 'student' : 'general',
+        records.signups[0]?.id || null,
+        records.students[0]?.id || null,
+        `Parent ${email} set or reset a parent portal password.`,
+        JSON.stringify({
+          parent_email: email,
+          reset_token_id: reset.id,
+          internal_tags: parentInteractionTags('access_issue', 'access', 'password set'),
+        }),
+      ]
+    ).catch(() => {});
+    if (client) await client.query('COMMIT');
+    return { parent_email: email };
+  } catch (error) {
+    if (client) {
+      try { await client.query('ROLLBACK'); } catch {}
+    }
+    throw error;
+  } finally {
+    if (client) client.release();
+  }
+}
 
