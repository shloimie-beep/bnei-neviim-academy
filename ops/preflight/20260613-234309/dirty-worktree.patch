-    },
-    {
-      id: generateId(),
-      title: 'Prepare parent communications update',
-      notes: 'Draft weekly update email for parents about upcoming events',
-      category: 'Communications',
-      urgency: 'Today',
-      status: 'Pending',
-      dueDate: today,
