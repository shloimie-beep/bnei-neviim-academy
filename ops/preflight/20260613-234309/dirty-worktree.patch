+function splitRambleIntoTaskFragments(ramble) {
+  const normalized = String(ramble || '')
+    .replace(/\s+/g, ' ')
+    .trim();
+  if (!normalized) return [];
+  return normalized
+    .replace(/\s+\b(another thing that i need to happen is|task for myself(?:\s+is)?|put something on my list|a decision for myself is|decision for myself is|anytime i tell you to test something|i still need to|i need to figure out|i need to finish|i need to make|tell codex|make sure these comments|make sure those comments|make sure the comments|when i add a comment|also why is there|why is there|what does that mean|what is the intake section|they never saw|the research section should|in the research section|all the questions that the boys asked|all of the topics|any topic|also check out|i wanted some sort|in the parent section|in the parents section|we have to have|make sure all of this)\b/gi, '\n$1')
+    .split(/\r?\n|[.;]|(?:\s+-\s+)/)
+    .flatMap((line) => line.length > 360
+      ? line.split(/\s+(?=(?:another thing|task for myself|put something on my list|a decision for myself|decision for myself|anytime i tell you|i still need to|i need to figure out|i need to finish|i need to make|tell codex|make sure these comments|make sure those comments|make sure the comments|when i add a comment|also why is there|why is there|what does that mean|what is the intake section|they never saw|the research section should|in the research section|all the questions that the boys asked|all of the topics|any topic|also check out|i wanted some sort|in the parent section|in the parents section|we have to have|make sure all of this)\b)/i)
+      : [line])
