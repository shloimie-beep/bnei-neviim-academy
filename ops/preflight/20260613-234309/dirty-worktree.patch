+function communityAutoIncludesActor(community, actor) {
+  if (!community || !actor) return false;
+  const metadata = parseJsonMaybe(community.metadata_json);
+  if (!metadata?.auto_include_bna_portal) return false;
+  return ['parent', 'student', 'service_provider'].includes(actor.type);
+}
