-  
-  await sendMessage(chatId,
-    `✅ Payment logged!\n\n` +
-    `Parent: ${signup.parent_name}\n` +
-    `Amount: ₪${amount}\n` +
-    `Method: ${method}\n` +
-    `Status: Paid`
