-
-function getProviders(): ChatProvider[] {
-  const providers: ChatProvider[] = [];
-
-  const kimiKey = process.env.KIMI_API_KEY?.trim();
-  if (kimiKey) {
-    providers.push({
-      name: 'kimi',
