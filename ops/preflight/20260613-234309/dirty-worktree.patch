+    if (!absent) continue;
+    existingStudentIds.add(Number(student.id));
+    synthesized.push({
+      student_id: student.id,
+      student_name: student.name,
+      goal_type: GOAL_TYPES.INSIDE,
+      engaged_listening_minutes: 0,
+      inside_engaged_minutes: 0,
+      listening_without_following_minutes: 0,
+      distracted_minutes: 0,
+      daily_completion_percentage: 0,
+      daily_completed_boolean: false,
