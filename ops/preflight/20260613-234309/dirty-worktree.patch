+async function getLatestTorahGoal(studentId, db = pool) {
+  const result = await db.query(
+    `SELECT *
+     FROM bna_torah_learning_goals
+     WHERE student_id = $1
+     ORDER BY start_date DESC, id DESC
+     LIMIT 1`,
+    [studentId]
+  );
