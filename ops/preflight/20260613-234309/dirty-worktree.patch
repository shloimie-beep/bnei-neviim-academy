+  const headChars = Math.round(maxChars * 0.62);
+  const tailChars = maxChars - headChars;
+  return [
+    transcript.slice(0, headChars),
+    '',
+    `[Middle of long transcript omitted for parser speed: ${transcript.length - maxChars} characters]`,
+    '',
