+async function communityMembershipForActor(communityId, actor, db = pool) {
+  if (!actor) return null;
+  const conditions = [`community_id = $1`, `actor_type = $2`, `status = 'active'`];
+  const params = [communityId, safeCommunityActorType(actor.type)];
+  if (actor.id) {
+    params.push(Number(actor.id));
+    conditions.push(`actor_id = $${params.length}`);
+  }
+  if (actor.email) {
+    params.push(normalizeEmail(actor.email));
+    conditions.push(`lower(actor_email) = $${params.length}`);
+  }
+  if (conditions.length <= 3) return null;
+  const result = await db.query(
+    `SELECT *
+     FROM bna_learning_community_members
+     WHERE ${conditions.slice(0, 3).join(' AND ')}
+       AND (${conditions.slice(3).join(' OR ')})
+     LIMIT 1`,
+    params
+  );
+  return result.rows[0] || null;
+}
+
+async function actorCanAccessCommunity(community, actor, db = pool) {
+  if (!community || community.status !== 'active') return false;
+  if (actor?.type === 'admin' || actor?.type === 'rabbi') return true;
+  if (community.visibility === 'public') return true;
+  if (communityAutoIncludesActor(community, actor)) return true;
+  return Boolean(await communityMembershipForActor(community.id, actor, db));
+}
+
+async function assertCommunityAccess(communityId, actor, db = pool) {
+  const community = (await db.query(
+    `SELECT *
+     FROM bna_learning_communities
+     WHERE id = $1
+       AND status = 'active'
+     LIMIT 1`,
+    [communityId]
+  )).rows[0];
+  if (!community || !(await actorCanAccessCommunity(community, actor, db))) {
+    const error = new Error('Learning community was not found for this actor');
+    error.statusCode = 404;
+    throw error;
+  }
+  return community;
+}
