+async function replaceScheduleItemsForAssignment(db, assignment = {}, rows = []) {
+  const schedulePlan = parseJsonMaybe(assignment.schedule_plan);
+  const sessions = Array.isArray(schedulePlan.sessions) ? schedulePlan.sessions : [];
+  await db.query('DELETE FROM bna_schedule_items WHERE assignment_id = $1', [assignment.id]);
+  if (!assignment.id || !rows.length || !sessions.length) return [];
+
+  const created = [];
+  for (const row of rows) {
+    for (const session of sessions) {
+      const result = await db.query(
+        `INSERT INTO bna_schedule_items (
+           assignment_id, assignment_student_id, student_id, title,
+           start_at, end_at, timezone, source, recurrence_json,
+           chunk_index, total_chunks, display_label, metadata
+         ) VALUES (
+           $1, $2, $3, $4,
+           $5::timestamp, $6::timestamp, $7, 'internal', $8,
+           $9, $10, $11, $12
+         )
+         RETURNING *`,
+        [
+          assignment.id,
+          row.id || null,
+          row.student_id || null,
+          assignment.title || 'BNA assignment',
+          session.start_at || session.startDateTime || null,
+          session.end_at || session.endDateTime || null,
+          schedulePlan.timezone || session.timezone || BNA_TIME_ZONE,
+          JSON.stringify(session.recurrence || schedulePlan.recurrence || {}),
+          session.chunk_index || null,
+          session.total_chunks || sessions.length,
+          session.display_label || session.label || null,
+          JSON.stringify({
+            assignmentId: assignment.id,
+            studentId: row.student_id || null,
+            startDateTime: session.startDateTime || session.start_rfc3339 || session.start_at || null,
+            endDateTime: session.endDateTime || session.end_rfc3339 || session.end_at || null,
+            timezone: schedulePlan.timezone || session.timezone || BNA_TIME_ZONE,
+          }),
+        ]
+      );
+      created.push(result.rows[0]);
+    }
+  }
+  return created;
+}
