+async function resolveCommunityActor(req, db = pool) {
+  const body = req.body || {};
+  const query = req.query || {};
+  const adminIdentity = await identifyAdminRequest(req);
+  if (adminIdentity) {
+    return {
+      type: 'admin',
+      id: null,
+      email: adminIdentity.username || null,
+      name: adminIdentity.username || 'BNA Admin',
+      role: adminIdentity.role || 'admin',
+    };
+  }
+
+  const cookies = parseCookies(req);
+  const parentSession = await getValidParentSession(cookies[PARENT_SESSION_COOKIE_NAME], db).catch(() => null);
+  if (parentSession) {
+    return {
+      type: 'parent',
+      id: null,
+      email: parentSession.parentEmail,
+      name: parentSession.parentEmail,
+      role: 'parent',
+    };
+  }
+
+  const providerSession = await getValidProviderSession(cookies[PROVIDER_SESSION_COOKIE_NAME], db).catch(() => null);
+  if (providerSession) {
+    return {
+      type: 'service_provider',
+      id: providerSession.providerId,
+      email: null,
+      name: providerSession.providerName || 'Service Provider',
+      role: 'provider',
+    };
+  }
+
+  const accessCode = String(body.access_code || query.access_code || query.code || '').trim();
+  if (accessCode) {
+    const student = await findStudentByAccessCode(accessCode, db);
+    if (student) {
+      return {
+        type: 'student',
+        id: Number(student.id),
+        email: normalizeEmail(student.parent_email) || null,
+        name: student.name || 'Student',
+        role: 'student',
+      };
+    }
+  }
+
+  return null;
+}
