+function parentChatAccountabilityPayload({ message, student, parentEmail, communicationId }) {
+  const eventType = detectParentChatEventType(message);
+  const titlePrefix = eventType === 'question'
+    ? 'Parent question'
+    : eventType === 'student_goal'
+      ? 'Parent goal update'
+      : eventType === 'decision'
+        ? 'Parent decision update'
+        : 'Parent accountability update';
+  const title = `${titlePrefix}: ${firstCompactSentence(message, student.name)}`.slice(0, 240);
+  let metadata = {
+    parser: 'parent-chat-v1',
+    source: 'parent_portal',
+    kind: 'parent_chat',
+    visibility: 'parent_review',
+    parent_visible: true,
+    student_visible: false,
+    review_required: true,
+    parent_email: normalizeEmail(parentEmail),
+    parent_chat_communication_id: communicationId,
+  };
+  const progressPercent = eventType === 'student_goal' ? extractParentChatProgressPercent(message) : null;
+  if (eventType === 'student_goal') {
+    metadata = goalBoardMetadataFromPayload({
+      goal_board: parentReviewGoalBoardPayload({
+        text: message,
+        source: 'parent_update',
+        progressPercent,
+      }),
+    }, metadata);
+  }
+  return {
+    event_type: eventType,
+    title,
+    notes: message,
+    topic: 'Parent chat',
+    question_text: eventType === 'question' ? message : null,
+    progress_percent: progressPercent,
+    attendance_status: detectParentChatAttendanceStatus(message),
+    engagement_level: detectParentChatEngagementLevel(message),
+    next_check_in_date: extractParentChatNextCheckInDate(message),
+    follow_up_required: true,
+    metadata,
