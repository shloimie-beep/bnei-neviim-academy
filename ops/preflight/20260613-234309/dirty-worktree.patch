-      expires_at: parsed.data.expiresAt ?? null,
-    })
-    .select()
-    .single();
-
-  if (error) {
-    return NextResponse.json({ ok: false, error: error.message }, { status: 500 });
-  }
-  return NextResponse.json({ ok: true, goal: data });
-}
