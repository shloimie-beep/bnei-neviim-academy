+      [
+        seed.name,
+        seed.name,
+        seed.name_he || null,
+        matchingIntake?.parent_name || null,
+        null,
+        matchingIntake?.parent_phone || null,
+        ['student', 'bna', 'torah_goal'],
+        `Seeded for Torah learning group goal on ${TORAH_TEMP_SEED_DATE}.`,
+      ]
+    );
+    students.push(inserted.rows[0]);
+  }
+}
