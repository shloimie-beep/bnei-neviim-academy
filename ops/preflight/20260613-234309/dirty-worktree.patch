+function uniqueWebsiteBlogSlug(baseSlug, posts, currentPostId = null) {
+  const root = baseSlug || 'bna-article';
+  let slug = root;
+  let suffix = 2;
+  const taken = (candidate) => posts.some((post) => post.slug === candidate && post.id !== currentPostId);
+  while (taken(slug)) {
+    slug = `${root}-${suffix++}`;
+  }
+  return slug;
+}
