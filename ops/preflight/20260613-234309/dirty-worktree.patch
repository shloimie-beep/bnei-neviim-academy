+            prompt_patch_instruction: row.prompt_patch_instruction || '',
+          })),
+        }, null, 2),
+      ].join('\n'),
+    },
+  ];
+  const primary = {
+    provider: CONTENT_AI_PROVIDER,
+    baseUrl: CONTENT_AI_BASE_URL,
+    apiKey: CONTENT_AI_API_KEY,
+    model: CONTENT_AI_MODEL,
+  };
+  const requestWorksheet = async (providerConfig) => fetchChatCompletionText({
+    provider: providerConfig.provider,
+    baseUrl: providerConfig.baseUrl,
+    apiKey: providerConfig.apiKey,
+    payload: {
+      model: providerConfig.model,
+      temperature: providerConfig.provider === 'kimi' ? 1 : 0.35,
+      messages,
+    },
+  });
+  try {
+    return String(await requestWorksheet(primary)).trim();
+  } catch (primaryError) {
+    const fallback = contentAiFallbackConfig();
+    if (!fallback) return basicAssignmentWorksheet({ assignment, rows, instruction });
+    try {
+      return String(await requestWorksheet(fallback)).trim();
+    } catch {
+      return basicAssignmentWorksheet({ assignment, rows, instruction });
+    }
+  }
+}
