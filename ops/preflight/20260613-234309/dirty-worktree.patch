-  }
-  if (!serviceKey) {
-    throw new Error(
-      'getSupabaseAdminClient: SUPABASE_SERVICE_ROLE_KEY is not set'
-    );
-  }
-
-  cached = createClient(url, serviceKey, {
-    auth: {
-      persistSession: false,
-      autoRefreshToken: false,
-      detectSessionInUrl: false,
-    },
