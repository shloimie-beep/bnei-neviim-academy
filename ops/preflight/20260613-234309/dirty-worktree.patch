+async function applyParentNotificationAction(client, { communication, parentEmail, action, response = '' }) {
+  const metadata = parseJsonMaybe(communication.metadata);
+  const sourceContext = parseJsonMaybe(communication.source_context);
+  const kind = metadata.kind || sourceContext.kind || 'parent_notification';
+  const normalizedAction = String(action || '').trim().toLowerCase();
+  const status = normalizedAction === 'approve' ? 'approved' : 'denied';
+  const respondedAt = new Date().toISOString();
+  const parentAction = {
+    status,
+    action: normalizedAction,
+    response: String(response || '').trim().slice(0, 1200),
+    parent_email: normalizeEmail(parentEmail),
+    responded_at: respondedAt,
+    source: 'parent_portal',
+  };
+  const actionHistory = Array.isArray(metadata.parent_action_history) ? metadata.parent_action_history : [];
+  const nextMetadata = {
+    ...metadata,
+    action_status: status,
+    parent_action: parentAction,
+    parent_action_history: [parentAction, ...actionHistory].slice(0, 20),
+  };
+  const updatedCommunication = (await client.query(
+    `UPDATE bna_contact_communications
+     SET metadata = $2,
+         follow_up_required = $3,
+         updated_at = NOW()
+     WHERE id = $1
+     RETURNING id, student_id, direction, summary, body, occurred_at, created_at, metadata, source_context`,
+    [
+      communication.id,
+      JSON.stringify(nextMetadata),
+      status === 'denied',
+    ]
+  )).rows[0];
+
+  const eventId = Number(metadata.accountability_event_id || 0);
+  if (eventId) {
+    const eventRow = (await client.query(
+      `SELECT *
+       FROM bna_accountability_events
+       WHERE id = $1
+       LIMIT 1`,
+      [eventId]
+    )).rows[0];
+    if (eventRow) {
+      const eventMetadata = parseJsonMaybe(eventRow.metadata);
+      const actionLine = `Parent ${status === 'approved' ? 'approved' : 'denied'} via parent portal${parentAction.response ? `: ${parentAction.response}` : '.'}`;
+      await client.query(
+        `UPDATE bna_accountability_events
+         SET notes = $2,
+             follow_up_required = $3,
+             metadata = $4,
+             updated_at = NOW()
+         WHERE id = $1`,
+        [
+          eventRow.id,
+          [eventRow.notes, actionLine].filter(Boolean).join('\n\n'),
+          status === 'denied',
+          JSON.stringify({
+            ...eventMetadata,
+            action_status: status,
+            parent_action: parentAction,
+            review_required: status === 'denied',
+            resolved_at: respondedAt,
+          }),
+        ]
+      );
+    }
+  }
+
+  const goalId = Number(metadata.goal_id || sourceContext.goal_id || 0);
+  if (goalId) {
+    await stampGoalParentReview(client, {
+      goalId,
+      communicationId: communication.id,
+      accountabilityEventId: eventId,
+      parentEmail,
+      status,
+      action: normalizedAction,
+      response: parentAction.response,
+      kind,
+      occurredAt: respondedAt,
+    });
+  }
+
+  return {
+    communication: updatedCommunication,
+    parent_action: parentAction,
+  };
+}
