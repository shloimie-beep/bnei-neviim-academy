+async function createVideoProcessingJobForAssignment({
+  assignmentId,
+  sourceUrl,
+  metadata = {},
+  requestedBy = 'system',
+  autoStart = true,
+} = {}, db = pool) {
+  const url = String(sourceUrl || '').trim();
+  if (!url) return null;
+  const status = BNA_YTDLP_ENABLED ? 'pending' : 'skipped';
+  const result = await db.query(
+    `INSERT INTO bna_video_processing_jobs (
+       assignment_id, source_url, provider, status, metadata_json, error_message
+     ) VALUES (
+       $1, $2, 'youtube', $3, $4, $5
+     )
+     RETURNING *`,
+    [
+      assignmentId || null,
+      url,
+      status,
+      JSON.stringify({
+        ...metadata,
+        requested_by: requestedBy,
+        yt_dlp_enabled: BNA_YTDLP_ENABLED,
+        ffmpeg_location_configured: Boolean(YTDLP_FFMPEG_LOCATION),
+      }),
+      BNA_YTDLP_ENABLED ? null : 'yt-dlp internal downloads are disabled by BNA_YTDLP_ENABLED',
+    ]
+  );
+  const job = result.rows[0];
+  if (BNA_YTDLP_ENABLED && autoStart) {
+    setImmediate(() => runVideoProcessingJob(job.id).catch((err) => {
+      console.error('[video-processing] background job failed', err);
+    }));
+  }
+  return job;
+}
+
+async function runVideoProcessingJob(jobId) {
+  const job = (await pool.query('SELECT * FROM bna_video_processing_jobs WHERE id = $1', [jobId])).rows[0];
+  if (!job || job.status !== 'pending') return job || null;
+
+  await pool.query(
+    `UPDATE bna_video_processing_jobs
+     SET status = 'downloading', updated_at = NOW()
+     WHERE id = $1`,
+    [job.id]
+  );
+
+  fs.mkdirSync(YTDLP_OUTPUT_DIR, { recursive: true });
+  const videoId = youtubeVideoIdFromUrl(job.source_url) || `job-${job.id}`;
+  const outputTemplate = path.join(
+    YTDLP_OUTPUT_DIR,
+    `${safeMediaFilePart(job.assignment_id || 'assignment')}-${safeMediaFilePart(videoId)}.%(ext)s`
+  );
+  const args = [
+    '-f', 'bv*+ba/b',
+    '--merge-output-format', 'mp4',
+    '-o', outputTemplate,
+  ];
+  if (YTDLP_FFMPEG_LOCATION) args.push('--ffmpeg-location', YTDLP_FFMPEG_LOCATION);
+  args.push(job.source_url);
+
+  // Server-side only: yt-dlp processing is for media BNA owns, has permission
+  // to use, or is otherwise allowed to process. Browsers never run downloads.
+  await new Promise((resolve) => {
+    const child = spawn(YTDLP_BINARY, args, { windowsHide: true });
+    let stderr = '';
+    child.stderr.on('data', (chunk) => { stderr += chunk.toString(); });
+    child.on('error', async (err) => {
+      await pool.query(
+        `UPDATE bna_video_processing_jobs
+         SET status = 'failed', error_message = $2, updated_at = NOW()
+         WHERE id = $1`,
+        [job.id, err.message]
+      );
+      resolve();
+    });
+    child.on('close', async (code) => {
+      if (code === 0) {
+        const expectedPath = outputTemplate.replace('%(ext)s', 'mp4');
+        await pool.query(
+          `UPDATE bna_video_processing_jobs
+           SET status = 'downloaded', output_file_path = $2, error_message = NULL, updated_at = NOW()
+           WHERE id = $1`,
+          [job.id, expectedPath]
+        );
+      } else {
+        await pool.query(
+          `UPDATE bna_video_processing_jobs
+           SET status = 'failed', error_message = $2, updated_at = NOW()
+           WHERE id = $1`,
+          [job.id, stderr.slice(0, 2000) || `yt-dlp exited with code ${code}`]
+        );
+      }
+      resolve();
+    });
+  });
+  return (await pool.query('SELECT * FROM bna_video_processing_jobs WHERE id = $1', [job.id])).rows[0];
+}
