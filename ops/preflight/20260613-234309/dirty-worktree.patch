+async function findActiveRecordsByParentPhone(phone, db = pool) {
+  const digits = normalizePhoneDigits(phone);
+  const suffix = digits.length >= 7 ? digits.slice(-9) : '';
+  if (!digits && !suffix) return [];
+  const result = await db.query(
+    `SELECT 'signup' AS kind, id, parent_name AS display_name, student_name, parent_email, parent_phone, status, created_at, updated_at
+     FROM signups
+     WHERE COALESCE(status, 'new') <> 'archived'
+       AND (
+         ($1 <> '' AND regexp_replace(COALESCE(parent_phone, ''), '\\D', '', 'g') = $1)
+         OR ($2 <> '' AND right(regexp_replace(COALESCE(parent_phone, ''), '\\D', '', 'g'), 9) = $2)
+       )
+     UNION ALL
+     SELECT 'student' AS kind, id, parent_name AS display_name, name AS student_name, parent_email, parent_phone, status, created_at, updated_at
+     FROM bna_students
+     WHERE COALESCE(status, 'active') NOT IN ('inactive', 'archived')
+       AND (
+         ($1 <> '' AND regexp_replace(COALESCE(parent_phone, ''), '\\D', '', 'g') = $1)
+         OR ($2 <> '' AND right(regexp_replace(COALESCE(parent_phone, ''), '\\D', '', 'g'), 9) = $2)
+       )
+     UNION ALL
+     SELECT 'lead' AS kind, id, parent_name AS display_name, student_name, parent_email, parent_phone, status, created_at, updated_at
+     FROM bna_parent_leads
+     WHERE COALESCE(status, 'interested') <> 'archived'
+       AND (
+         ($1 <> '' AND regexp_replace(COALESCE(parent_phone, ''), '\\D', '', 'g') = $1)
+         OR ($2 <> '' AND right(regexp_replace(COALESCE(parent_phone, ''), '\\D', '', 'g'), 9) = $2)
+         OR EXISTS (
+           SELECT 1
+           FROM unnest(COALESCE(other_phones, '{}'::text[])) AS phone_value(value)
+           WHERE ($1 <> '' AND regexp_replace(COALESCE(phone_value.value, ''), '\\D', '', 'g') = $1)
+              OR ($2 <> '' AND right(regexp_replace(COALESCE(phone_value.value, ''), '\\D', '', 'g'), 9) = $2)
+         )
+       )
+     ORDER BY updated_at DESC NULLS LAST, created_at DESC`,
+    [digits, suffix]
+  );
+  return result.rows;
+}
 
