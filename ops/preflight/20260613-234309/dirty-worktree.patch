-// Callbacks
-// ============================================================
-
-async function findParentUserIdByName(
-  supabase: SupabaseAdminClient,
-  parentName: string,
-): Promise<string | null> {
-  const { data, error } = await supabase
-    .from('users')
-    .select('id')
-    .eq('role', 'parent')
-    .ilike('name', parentName)
-    .maybeSingle();
-  if (error || !data) return null;
