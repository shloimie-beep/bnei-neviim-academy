+function parsedTorahUpdateStudentId(update = {}, students = []) {
+  if (update.student_id) {
+    const matched = students.find((student) => Number(student.id) === Number(update.student_id));
+    if (matched) return Number(matched.id);
+  }
+  const matched = findStudentForParsedName(update.student_name, students);
+  return matched ? Number(matched.id) : null;
+}
