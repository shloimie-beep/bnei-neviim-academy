+    const count = Math.max(1, Math.min(10, Number(lower.match(/\b(?:into\s+)?(\d{1,2})\s+(?:sessions?|lessons?|classes?|parts?)\b/)?.[1] || 3)));
+    for (let index = 0; index < count; index += 1) {
