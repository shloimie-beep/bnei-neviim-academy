+function buildClassroomCourseWorkPayload(assignment = {}, rows = [], options = {}) {
+  const schedulePlan = parseJsonMaybe(assignment.schedule_plan);
+  const firstRow = rows[0] || {};
+  const scheduledAt = firstRow.scheduled_start_at || schedulePlan.scheduled_start_at || null;
+  const dueAt = firstRow.due_at || schedulePlan.due_at || null;
+  const dueDate = dueAt ? new Date(dueAt) : null;
+  const classroomStudentIds = rows.map((row) => String(row.classroom_student_id || '').trim()).filter(Boolean);
+  const classroomState = ['DRAFT', 'PUBLISHED'].includes(String(options.state || '').toUpperCase())
+    ? String(options.state).toUpperCase()
+    : 'DRAFT';
+  const description = [
+    assignment.instructions,
+    assignmentWorksheetForStudent(assignment, firstRow),
+    assignmentMaterialUrl(assignment) ? `Material: ${assignmentMaterialUrl(assignment)}` : '',
+  ].filter(Boolean).join('\n\n').slice(0, 30000);
+  const body = {
+    title: String(assignment.title || 'BNA Assignment').slice(0, 3000),
+    description,
+    materials: buildClassroomMaterials(assignment),
+    workType: 'ASSIGNMENT',
+    state: classroomState,
+    assigneeMode: 'ALL_STUDENTS',
+  };
+  if (scheduledAt) body.scheduledTime = new Date(scheduledAt).toISOString();
+  if (dueDate && Number.isFinite(dueDate.getTime())) {
+    body.dueDate = utcClassroomDate(dueDate);
+    body.dueTime = utcClassroomTime(dueDate);
+  }
+  if (classroomStudentIds.length && classroomStudentIds.length === rows.length) {
+    body.assigneeMode = 'INDIVIDUAL_STUDENTS';
+    body.individualStudentsOptions = { studentIds: classroomStudentIds };
