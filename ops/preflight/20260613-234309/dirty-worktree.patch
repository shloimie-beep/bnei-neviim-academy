+function firstCompactSentence(value, fallback = 'Parent chat update') {
+  const compact = String(value || '').replace(/\s+/g, ' ').trim();
+  if (!compact) return fallback;
+  const sentence = compact.split(/(?<=[.!?])\s+/)[0] || compact;
+  return sentence.slice(0, 140);
+}
+
+function detectParentChatEventType(message) {
+  const text = String(message || '').toLowerCase();
+  if (/\?|\b(question|ask|asking|wonder|wondering|confused|source|answer)\b/.test(text)) return 'question';
+  if (/\b(goal|goals|progress|practice|streak|complete|completed|finish|finished|done|worked on|minutes?|percent|%|bedtime|chores?|floor|clean|permission|incentive|reward|consequence)\b/.test(text)) return 'student_goal';
+  if (/\b(decide|decided|decision|approve|approved|permission|allow|deny|denied|agreement|agreed)\b/.test(text)) return 'decision';
+  return 'learning_note';
+}
+
+function detectParentChatAttendanceStatus(message) {
+  const text = String(message || '').toLowerCase();
+  if (/\b(absent|missed|not coming|could not come|couldn't come|sick|home today)\b/.test(text)) return 'absent';
+  if (/\b(late|arrived late|coming late)\b/.test(text)) return 'late';
+  if (/\b(present|came|attended|showed up|was there)\b/.test(text)) return 'present';
+  return null;
+}
+
+function detectParentChatEngagementLevel(message) {
+  const text = String(message || '').toLowerCase();
+  if (/\b(excellent|great|strong|focused|engaged|motivated)\b/.test(text)) return 'strong';
+  if (/\b(ok|okay|fine|medium|somewhat|mixed)\b/.test(text)) return 'mixed';
+  if (/\b(low|struggling|resistant|distracted|not motivated|unfocused|hard time)\b/.test(text)) return 'needs_support';
+  return null;
+}
+
+function extractParentChatProgressPercent(message) {
+  const text = String(message || '');
+  const percentMatch = text.match(/\b(100|[1-9]?\d)\s*(?:%|percent)\b/i);
+  if (percentMatch) return clampProgressPercent(percentMatch[1]);
+  if (/\b(done|finished|completed|complete)\b/i.test(text)) return 100;
+  if (/\b(half|halfway)\b/i.test(text)) return 50;
+  return null;
+}
+
+function extractParentChatNextCheckInDate(message) {
+  const text = String(message || '').toLowerCase();
+  const explicit = text.match(/\b(20\d{2}-\d{2}-\d{2})\b/);
+  if (explicit) return safeIsoDateInput(explicit[1]) || null;
+  if (/\b(tomorrow|next day)\b/.test(text)) return addDaysToDateString(getTodayDateInTimeZone(), 1);
+  if (/\b(next week)\b/.test(text)) return addDaysToDateString(getTodayDateInTimeZone(), 7);
+  return null;
+}
+
+function inferParentGoalSection(text, fallback = 'learning') {
+  const value = String(text || '').toLowerCase();
+  if (/\b(bed|bedtime|sleep|floor|clean|cleanup|chores?|room|home|family)\b/.test(value)) return 'personal_home';
+  if (/\b(permission|allow|allowed|go out|outside|friend|device|phone|computer)\b/.test(value)) return 'permissions';
+  if (/\b(incentive|reward|prize|percent|percentage|trip|bonus)\b/.test(value)) return 'incentives';
+  if (/\b(meeting|check[-\s]?in|rabbi|parent meeting)\b/.test(value)) return 'meetings';
+  if (/\b(learn|learning|torah|mishna|mishnayos|gemara|reading|minutes?|assignment)\b/.test(value)) return 'learning';
+  return normalizeGoalBoardSection(fallback || 'learning');
+}
+
+function parentGoalChecklistFromText(text) {
+  const value = String(text || '');
+  const lower = value.toLowerCase();
+  const checklist = [];
+  if (/\bfloor\b|\bclean/.test(lower)) checklist.push('Finish the agreed floor cleanup.');
+  if (/\bbed\b|\b10\b|\bten\b/.test(lower)) checklist.push('Be in bed at the agreed bedtime.');
+  if (/\blearn|torah|mishna|reading|minutes?/.test(lower)) checklist.push('Complete the agreed learning block.');
+  if (!checklist.length) checklist.push(firstCompactSentence(value, 'Complete the parent-agreed goal.'));
+  return checklist.slice(0, 8);
+}
+
+function parentGoalConsequenceFromText(text) {
+  const value = String(text || '').trim();
+  if (/\b(no|can't|cannot|not)\s+go\s+out\b|\bno\s+going\s+out\b/i.test(value)) {
+    return 'No going out the next day if the agreed responsibility is not completed.';
+  }
+  const consequenceMatch = value.match(/\bconsequence(?: is|:)?\s+(.{8,180})/i);
+  return consequenceMatch ? consequenceMatch[1].trim() : '';
+}
+
+function parentGoalIncentiveFromText(text) {
+  const value = String(text || '').trim();
+  if (!/\b(incentive|reward|prize|bonus)\b/i.test(value)) return {};
+  const percentMatch = value.match(/\b(100|[1-9]?\d)\s*(?:%|percent)\b/i);
+  return {
+    text: firstCompactSentence(value, 'Parent-defined incentive'),
+    chosen_by: 'parent',
+    percent_target: percentMatch ? Number(percentMatch[1]) : null,
+  };
+}
+
+function parentReviewGoalBoardPayload({
+  text = '',
+  source = 'parent_update',
+  category = '',
+  section = '',
+  subsection = '',
+  progressPercent = null,
+  event = {},
+} = {}) {
+  const rawGoalBoard = event.goal_board && typeof event.goal_board === 'object' ? event.goal_board : {};
+  const rawSection = section || event.section || event.goal_section || rawGoalBoard.section || category || event.category || event.topic || text;
+  const normalizedSection = inferParentGoalSection(rawSection, 'learning');
+  const chosenConsequence = event.chosen_consequence || rawGoalBoard.chosen_consequence || event.consequence || parentGoalConsequenceFromText(text);
+  const checklist = Array.isArray(rawGoalBoard.checklist)
+    ? rawGoalBoard.checklist
+    : Array.isArray(event.checklist)
+      ? event.checklist
+      : parentGoalChecklistFromText(text);
+  return {
+    ...rawGoalBoard,
+    source,
+    category: category || event.category || event.topic || normalizedSection,
+    section: normalizedSection,
+    subsection: subsection || event.subsection || event.goal_subsection || rawGoalBoard.subsection || (source === 'parent_meeting' ? 'Parent meeting' : 'Parent update'),
+    urgency: event.urgency || rawGoalBoard.urgency || 'this_week',
+    status: 'waiting',
+    progress_percent: progressPercent,
+    parent_visible: true,
+    student_visible: false,
+    approval_required: true,
+    approval_status: 'pending_review',
+    student_summary: event.student_summary || rawGoalBoard.student_summary || firstCompactSentence(text, 'Parent-created goal'),
+    private_note: event.private_note || rawGoalBoard.private_note || 'Parent-created update is waiting for Rabbi/admin review before it is shown to the student.',
+    checklist,
+    agreement_type: event.agreement_type || rawGoalBoard.agreement_type || (normalizedSection === 'personal_home' ? 'home_responsibility' : ''),
+    bedtime_time: event.bedtime_time || rawGoalBoard.bedtime_time || (/\b10(?::00)?\b/.test(String(text || '')) ? '22:00' : ''),
+    student_commitment: event.student_commitment || rawGoalBoard.student_commitment || firstCompactSentence(text, ''),
+    chosen_consequence: chosenConsequence,
+    recovery_path: event.recovery_path || rawGoalBoard.recovery_path || chosenConsequence,
+    consequence_status: event.consequence_status || rawGoalBoard.consequence_status || (chosenConsequence ? 'pending_review' : 'none'),
+    review_reason: event.review_reason || rawGoalBoard.review_reason || 'Parent-created consequence/permission/incentive needs Rabbi/admin approval before student visibility.',
+    incentive: event.incentive || rawGoalBoard.incentive || parentGoalIncentiveFromText(text),
+  };
+}
