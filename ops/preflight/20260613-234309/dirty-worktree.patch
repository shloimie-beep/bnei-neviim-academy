+        function positionFilterDropdown(dropdown) {
+            if (!dropdown) return;
+            const button = dropdown.querySelector('.filter-dropdown-button');
+            const menu = dropdown.querySelector('.filter-dropdown-menu');
+            if (!button || !menu) return;
+            const rect = button.getBoundingClientRect();
+            const gap = 6;
+            const viewportWidth = window.innerWidth || document.documentElement.clientWidth || 1024;
+            const viewportHeight = window.innerHeight || document.documentElement.clientHeight || 768;
+            const desiredWidth = Math.max(rect.width, 210);
+            const width = Math.min(desiredWidth, Math.max(180, viewportWidth - 16));
+            const left = Math.min(Math.max(8, rect.left), Math.max(8, viewportWidth - width - 8));
+            const spaceBelow = viewportHeight - rect.bottom - gap - 8;
+            const spaceAbove = rect.top - gap - 8;
+            const openAbove = spaceBelow < 180 && spaceAbove > spaceBelow;
+            const maxHeight = Math.max(160, Math.min(320, openAbove ? spaceAbove : spaceBelow));
+            const top = openAbove
