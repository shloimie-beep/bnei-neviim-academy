+    .replace(/^gh[pousr]_/i, '')
+    .replace(/^railway_/i, '')
+    .replace(/^\d{7,12}:/, '')
+    .replace(/[_-]/g, '');
+  if (body.length < 20) return false;
+  const unique = new Set(body.toLowerCase().split(''));
+  return unique.size <= 3;
