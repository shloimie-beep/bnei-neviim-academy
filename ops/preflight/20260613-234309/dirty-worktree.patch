+async function createGoogleClientForConnection(options = {}, db = pool) {
+  const connectionId = Number(options.connection_id || options.connectionId || 0);
+  const connectionRole = googleAuthService.normalizeGoogleConnectionRole(options.role || options.connection_role);
+  let row = null;
+
+  if (connectionId) {
+    row = (await db.query(
+      `SELECT *
+       FROM bna_google_connections
+       WHERE id = $1
+         AND COALESCE(status, 'connected') = 'connected'
+       LIMIT 1`,
+      [connectionId]
+    )).rows[0] || null;
+  } else if (connectionRole !== 'admin_teacher' || options.student_id || options.parent_email) {
+    const params = [connectionRole];
+    const conditions = ["connection_role = $1", "COALESCE(status, 'connected') = 'connected'", "refresh_token IS NOT NULL", "refresh_token <> ''"];
+    if (options.student_id) {
+      params.push(Number(options.student_id));
+      conditions.push(`student_id = $${params.length}`);
+    }
+    if (options.parent_email) {
+      params.push(String(options.parent_email).trim().toLowerCase());
+      conditions.push(`lower(COALESCE(parent_email, '')) = $${params.length}`);
+    }
+    row = (await db.query(
+      `SELECT *
+       FROM bna_google_connections
+       WHERE ${conditions.join(' AND ')}
+       ORDER BY updated_at DESC NULLS LAST, connected_at DESC NULLS LAST, id DESC
+       LIMIT 1`,
+      params
+    )).rows[0] || null;
+  }
