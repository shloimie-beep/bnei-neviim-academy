+function hasAbsentTorahScoreSignal(text) {
+  return /\b(?:wasn'?t|was not|isn'?t|is not|not)\s+(?:here|present)\b/i.test(text)
+    || /\b(absent|missed|didn'?t come|couldn'?t come|home today|was away)\b/i.test(text);
+}
