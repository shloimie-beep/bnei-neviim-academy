+async function createParentActionNotification(client, {
+  student,
+  goal = null,
+  kind = 'goal_checkoff',
+  message = '',
+  checkoff = {},
+} = {}) {
+  const notificationStudent = await hydrateStudentParentNotificationRecord(student, client);
+  const parentEmail = normalizeEmail(notificationStudent.parent_email);
+  if (!parentEmail) return null;
+
+  const goalId = Number(goal?.id || checkoff.goal_id || 0) || null;
+  const goalTitle = goal?.title || checkoff.goal_title || '';
+  const summary = kind === 'student_parent_message'
+    ? `Student message to parent from ${notificationStudent.name || 'student'}`
+    : `${notificationStudent.name || 'Student'} checkoff needs parent review`;
+  const body = parentNotificationBody({
+    student: notificationStudent,
+    goal,
+    kind,
+    message,
+    checkoff,
+  });
+  const metadata = {
+    parent_notification: true,
+    kind,
+    parent_email: parentEmail,
+    student_id: Number(notificationStudent.id),
+    student_name: notificationStudent.name || '',
+    goal_id: goalId,
+    goal_title: goalTitle,
+    checkoff_date: checkoff.date || null,
+    progress_percent: checkoff.progress_percent ?? goal?.progress_percent ?? null,
+    action_status: 'pending',
+    parent_action: {
+      status: 'pending',
+      action: 'pending_parent_review',
+    },
+  };
+  const sourceContext = {
+    source: 'student_portal',
+    kind,
+    goal_id: goalId,
+    goal_title: goalTitle,
+    checkoff,
+  };
+  const communication = (await client.query(
+    `INSERT INTO bna_contact_communications (
+       contact_type, student_id, channel, direction, summary, body,
+       follow_up_required, occurred_at, created_by, source, source_context, metadata
+     ) VALUES (
+       'student', $1, 'other', 'outbound', $2, $3,
+       TRUE, NOW(), 'student_portal', 'dashboard', $4, $5
+     )
+     RETURNING id, student_id, direction, summary, body, occurred_at, created_at, metadata, source_context`,
+    [
+      notificationStudent.id,
+      summary,
+      body,
+      JSON.stringify(sourceContext),
+      JSON.stringify(metadata),
+    ]
+  )).rows[0];
+
+  const eventMetadata = {
+    ...metadata,
+    source: 'student_portal',
+    review_required: true,
+    parent_notification_communication_id: communication.id,
+    parent_visible: true,
+    student_visible: false,
+  };
+  const event = (await client.query(
+    `INSERT INTO bna_accountability_events (
+       event_type, student_id, student_name, title, notes, topic,
+       progress_percent, follow_up_required, metadata, source, source_message_id, occurred_at
+     ) VALUES (
+       'decision', $1, $2, $3, $4, $5,
+       $6, TRUE, $7, 'manual', $8, NOW()
+     )
+     RETURNING *`,
+    [
+      notificationStudent.id,
+      notificationStudent.name,
+      summary.slice(0, 240),
+      body,
+      parentNotificationKindLabel(kind),
+      checkoff.progress_percent ?? goal?.progress_percent ?? null,
+      JSON.stringify(eventMetadata),
+      parentNotificationSourceId(communication.id),
+    ]
+  )).rows[0];
+
+  const communicationMetadata = {
+    ...metadata,
+    accountability_event_id: event.id,
+  };
+  const updatedCommunication = (await client.query(
+    `UPDATE bna_contact_communications
+     SET metadata = $2,
+         updated_at = NOW()
+     WHERE id = $1
+     RETURNING id, student_id, direction, summary, body, occurred_at, created_at, metadata, source_context`,
+    [communication.id, JSON.stringify(communicationMetadata)]
+  )).rows[0] || communication;
+
+  if (goalId) {
+    await stampGoalParentReview(client, {
+      goalId,
+      communicationId: communication.id,
+      accountabilityEventId: event.id,
+      parentEmail,
+      status: 'pending',
+      kind,
+      occurredAt: new Date().toISOString(),
+    });
+  }
+
+  return { communication: updatedCommunication, event };
+}
