+            menu.style.setProperty('--dropdown-left', `${Math.round(left)}px`);
+            menu.style.setProperty('--dropdown-width', `${Math.round(width)}px`);
+            menu.style.setProperty('--dropdown-max-height', `${Math.round(maxHeight)}px`);
+        }
