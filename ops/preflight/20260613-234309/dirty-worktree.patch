+    }
+  } else if (/\bnext\s+(\d{1,2})\s+days?\b/.test(lower) || /\bfor\s+(?:the\s+)?next\s+(\d{1,2})\s+days?\b/.test(lower) || /\bfor\s+(\d{1,2})\s+days?\b/.test(lower)) {
+    const count = Math.max(1, Math.min(14, Number(lower.match(/\bnext\s+(\d{1,2})\s+days?\b/)?.[1] || lower.match(/\bfor\s+(?:the\s+)?next\s+(\d{1,2})\s+days?\b/)?.[1] || lower.match(/\bfor\s+(\d{1,2})\s+days?\b/)?.[1] || 4)));
+    for (let index = 0; index < count; index += 1) {
+      sessions.push({ label: `Day ${index + 1}`, date: addDaysToDateString(today, index), hour: parsedTime.hour, minute: parsedTime.minute, duration_minutes: durationMinutes });
+    }
+  } else if (text) {
+    sessions.push({ label: 'Session 1', date: today, hour: parsedTime.hour, minute: parsedTime.minute, duration_minutes: durationMinutes });
