-}
-
-// ---------------------------------------------------------------------------
-// PIN verification
-// ---------------------------------------------------------------------------
-
-export type VerifyPinResult =
-  | { ok: true; kidId: string; kidName: string }
-  | { ok: false; reason: 'invalid' | 'rate_limited'; retryAfterMs?: number };
