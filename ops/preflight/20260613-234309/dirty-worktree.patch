+function synthesizeAbsentDailyTorahUpdates({ job = {}, students = [], dailyTorahUpdates = [] } = {}) {
+  const text = String(job?.transcript_text || '');
+  if (!text || !Array.isArray(students) || !students.length) return dailyTorahUpdates;
+
+  const existingStudentIds = new Set(
+    (Array.isArray(dailyTorahUpdates) ? dailyTorahUpdates : [])
+      .map((update) => parsedTorahUpdateStudentId(update, students))
+      .filter((studentId) => studentId !== null)
+  );
+  const synthesized = [];
+
+  for (const student of students) {
+    if (existingStudentIds.has(Number(student.id))) continue;
+    const aliases = studentAliasesForServer(student)
+      .slice()
+      .sort((a, b) => b.length - a.length);
+
+    let absent = false;
+    for (const alias of aliases) {
+      const aliasPattern = escapeRegExp(alias).replace(/\s+/g, '[\\s,]+');
+      const matcher = new RegExp(`\\b${aliasPattern}\\b`, 'ig');
+      let match;
+      while ((match = matcher.exec(text))) {
+        const segment = extractNearbyText(text, match.index, match[0].length, 140);
+        if (hasAbsentTorahScoreSignal(segment)) {
+          absent = true;
+          break;
+        }
+      }
+      if (absent) break;
+    }
