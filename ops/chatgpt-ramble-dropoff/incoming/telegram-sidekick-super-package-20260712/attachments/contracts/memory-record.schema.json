{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bneineviimacademy.org/schemas/assistant-memory-record-v1.json",
  "title": "BNA Assistant Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_key", "namespace_type", "namespace_key", "memory_kind", "subject_key", "summary_text", "value", "sensitivity", "learned_by", "confidence", "status", "provenance", "version"],
  "properties": {
    "memory_key": {"type": "string", "minLength": 1},
    "namespace_type": {"enum": ["identity_private", "conversation", "workspace", "project", "provider", "platform_policy", "public_session"]},
    "namespace_key": {"type": "string", "minLength": 1},
    "owner_identity_key": {"type": ["string", "null"]},
    "workspace_key": {"type": ["string", "null"]},
    "project_key": {"type": ["string", "null"]},
    "provider_key": {"type": ["string", "null"]},
    "memory_kind": {"enum": ["preference", "instruction", "stable_fact", "relationship", "decision", "workflow", "summary", "setup_state"]},
    "subject_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$"},
    "summary_text": {"type": "string", "maxLength": 4000},
    "value": {},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "allowed_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "learned_by": {"enum": ["explicit", "confirmed", "inferred", "imported", "tool_verified"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["candidate", "active", "disputed", "superseded", "deleted", "expired"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_key", "message_key", "tool_run_key", "source_uri"],
      "properties": {
        "conversation_key": {"type": ["string", "null"]},
        "message_key": {"type": ["string", "null"]},
        "tool_run_key": {"type": ["string", "null"]},
        "source_uri": {"type": ["string", "null"]}
      }
    },
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
    "last_used_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "supersedes_memory_key": {"type": ["string", "null"]},
    "version": {"type": "integer", "minimum": 1},
    "metadata_redacted": {"type": "object"}
  }
}
