+                { id: 'services', label: 'Services' },
+                { id: 'commercial', label: 'Commercial Model' },
+                { id: 'entitlements', label: 'Entitlements' },
+            ];
+            if (portalEntitlementEnabled('landing_page_funnel') || portalEntitlementEnabled('content_video_workflow')) {
+                sections.push({ id: 'website_import', label: 'Website Import' });
+            }
+            if (portalEntitlementEnabled('email_workflows') || portalEntitlementEnabled('whatsapp_workflows') || portalEntitlementEnabled('support_tickets')) {
+                sections.push({ id: 'communications', label: 'Communications' });
+            }
+            if (portalEntitlementEnabled('provider_admin') || portalEntitlementEnabled('custom_partnership_terms')) {
+                sections.push({ id: 'integrations', label: 'External Apps' });
+                sections.push({ id: 'access', label: 'Access Checklist' });
+            }
+            sections.push({ id: 'activity', label: 'Activity' });
+            sections.push({ id: 'settings', label: 'Settings' });
+            return sections;
+        }
+
+        function setProviderSection(section) {
