+                button.disabled = false;
+            }
+        });
+
+        document.getElementById('logoutButton').addEventListener('click', async () => {
+            await api('/api/provider-portal/logout', { method: 'POST' }).catch(() => {});
+            showLogin();
+        });
+
+        document.getElementById('providerNav').addEventListener('click', (event) => {
+            const button = event.target.closest('[data-provider-nav]');
+            if (button) setProviderSection(button.dataset.providerNav);
+        });
+
+        document.getElementById('profileForm').addEventListener('submit', async (event) => {
+            event.preventDefault();
+            const button = event.submitter;
+            button.disabled = true;
+            try {
+                renderPortal(await api('/api/provider-portal/profile', {
+                    method: 'PATCH',
+                    body: JSON.stringify(formObject(event.currentTarget))
+                }));
+            } finally {
+                button.disabled = false;
