+            if (button) button.disabled = true;
+            if (status) {
+                status.textContent = t('saving');
+                status.classList.remove('error');
+            }
+            try {
+                await api('/api/parent-portal/help', {
+                    method: 'POST',
+                    body: JSON.stringify({
+                        category: formData.get('category'),
+                        student_id: formData.get('student_id'),
+                        message: formData.get('message'),
+                    }),
+                });
+                form.reset();
+                if (status) status.textContent = t('helpSent');
+            } catch (error) {
+                if (status) {
+                    status.textContent = error.message || t('helpFailed');
+                    status.classList.add('error');
+                } else {
+                    alert(error.message || t('helpFailed'));
+                }
+            } finally {
+                if (button) button.disabled = false;
+            }
+        }
+
+        function openProviderRequest(button) {
