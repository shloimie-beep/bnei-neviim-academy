+                await api('/api/parent-portal/login', {
+                    method: 'POST',
+                    body: JSON.stringify({
+                        parent_email: els.parentEmail.value,
+                        password: els.parentPassword.value,
+                    }),
+                });
+                await loadPortal();
+            } catch (error) {
+                els.loginStatus.textContent = error.message || t('loginFailed');
+                els.loginStatus.classList.add('error');
+            } finally {
+                els.requestButton.disabled = false;
+            }
+        });
+
+        els.showResetButton.addEventListener('click', () => {
+            els.resetEmail.value = els.parentEmail.value || '';
+            showPasswordResetRequest();
+        });
+
+        els.showLoginButton.addEventListener('click', () => showLogin());
+
+        els.resetRequestForm.addEventListener('submit', async (event) => {
+            event.preventDefault();
+            els.resetRequestButton.disabled = true;
+            els.loginStatus.textContent = t('saving');
+            els.loginStatus.classList.remove('error');
+            try {
+                await api('/api/parent-portal/password/request', {
+                    method: 'POST',
+                    body: JSON.stringify({ parent_email: els.resetEmail.value }),
+                });
+                els.loginStatus.textContent = t('passwordResetSent');
+            } catch (error) {
+                els.loginStatus.textContent = error.message || t('resetFailed');
+                els.loginStatus.classList.add('error');
+            } finally {
+                els.resetRequestButton.disabled = false;
+            }
+        });
+
+        els.resetPasswordForm.addEventListener('submit', async (event) => {
