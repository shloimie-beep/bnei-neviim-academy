+  const fragments = (keepWholeRoutingTask ? [text] : splitRambleIntoTaskFragments(text))
+    .filter((line) => !isTaskListLeadIn(line))
+    .filter((line) => !isDecisionLeadInOnly(line))
+    .slice(0, 14);
