+                    status.classList.remove('error');
+                }
+            });
+        }
+
+        async function verifyToken(token) {
+            els.loginPanel.classList.remove('hidden');
+            els.requestForm.classList.add('hidden');
+            els.portalPanel.classList.add('hidden');
+            els.portalMenuToggle.classList.add('hidden');
