+    } else if (candidate.kind === 'student') {
+      await db.query(
+        `UPDATE bna_students
+         SET status = 'inactive',
+             notes = CONCAT(COALESCE(notes, ''), CASE WHEN COALESCE(notes, '') = '' THEN '' ELSE E'\n' END, $2::text),
