+  }
+  if (isWatchdogWarningTaskText(lower)) {
+    return 'Add watchdog soft repair for obvious task warnings';
+  }
+  if (/(telegram|bot)/.test(lower) && /(button|buttons|quick action|mine|urgent|done)/.test(lower)) {
+    return 'Remove Telegram task quick-action buttons';
+  }
+  if (/(parents? (?:that are )?interested|interested parents?|warm leads?|contacts? pipeline|pipeline created from contacts?|parent section|parents section)/.test(lower)
+    && /(pipeline|contacts?|parents?|whatsapp|previous contact|contact history|login|logins?|parent portal|manage)/.test(lower)) {
