+                sections.push({ id: 'access', label: 'Access Checklist' });
+            }
+            sections.push({ id: 'activity', label: 'Activity' });
+            sections.push({ id: 'settings', label: 'Settings' });
+            return sections;
+        }
+
+        function setProviderSection(section) {
+            activeProviderSection = providerSections().some(item => item.id === section) ? section : 'overview';
+            document.querySelectorAll('[data-provider-section]').forEach(panel => {
+                panel.classList.toggle('provider-section-hidden', panel.dataset.providerSection !== activeProviderSection);
+            });
+            document.querySelectorAll('[data-provider-nav]').forEach(button => {
+                button.classList.toggle('active', button.dataset.providerNav === activeProviderSection);
+            });
+        }
+
+        function renderProviderNav() {
+            document.getElementById('providerNav').innerHTML = providerSections().map(section => `
+                <button type="button" data-provider-nav="${escapeHtml(section.id)}" class="${section.id === activeProviderSection ? 'active' : ''}">
+                    ${escapeHtml(section.label)}
+                </button>
+            `).join('');
+        }
+
+        function renderPortal(data) {
+            portalState = data;
+            const provider = data.provider || {};
+            const services = Array.isArray(data.services) ? data.services : [];
+            const entitlements = Array.isArray(data.entitlements) ? data.entitlements : [];
+            const integrations = Array.isArray(data.integrations) ? data.integrations : [];
+            const accessChecklist = Array.isArray(data.access_checklist) ? data.access_checklist : [];
+            const plan = provider.plan || {};
+            document.getElementById('loginPanel').classList.add('hidden');
+            document.getElementById('portalPanel').classList.remove('hidden');
+            document.getElementById('providerTitle').textContent = provider.provider_name || 'Provider portal';
+            document.getElementById('providerSubtitle').textContent = `${plan.label || provider.entitlement_plan || 'Provider'} / ${provider.status || 'review'} workspace`;
+            document.getElementById('profileNotice').textContent = data.guardrails?.public_changes || 'Edits stay pending review until BNA approves them.';
+            document.getElementById('providerOverview').innerHTML = `
+                <div class="overview-metric"><strong>${services.length}</strong><span class="small">Services</span></div>
+                <div class="overview-metric"><strong>${escapeHtml(provider.status || 'review')}</strong><span class="small">Listing status</span></div>
+                <div class="overview-metric"><strong>${escapeHtml(plan.label || provider.entitlement_plan || 'Plan')}</strong><span class="small">Commercial plan</span></div>
+                <div class="overview-metric"><strong>${escapeHtml(String(provider.integration_status || 'no_access').replace(/_/g, ' '))}</strong><span class="small">Integration status</span></div>
+            `;
+            document.getElementById('commercialSummary').innerHTML = `
+                <article class="service-card">
+                    <div class="service-head">
+                        <div>
+                            <h3>${escapeHtml(plan.label || provider.entitlement_plan || 'Provider plan')}</h3>
+                            <p class="small">${escapeHtml(plan.helper || 'Commercial settings are managed by BNA Operations.')}</p>
+                        </div>
+                        <span class="status-pill">${escapeHtml(String(provider.commercial_model || 'free_listing').replace(/_/g, ' '))}</span>
+                    </div>
+                    <div class="service-meta">
+                        <span class="status-pill">${escapeHtml(String(provider.provider_status || 'draft').replace(/_/g, ' '))}</span>
+                        <span class="status-pill">${escapeHtml(String(provider.source_of_truth || 'unknown_pending_access').replace(/_/g, ' '))}</span>
+                        <span class="status-pill">${escapeHtml(String(provider.integration_status || 'no_access').replace(/_/g, ' '))}</span>
+                        <span class="status-pill">${provider.public_signup_enabled ? 'public signup enabled' : 'public signup disabled'}</span>
+                    </div>
+                </article>
+            `;
+            document.getElementById('entitlementList').innerHTML = entitlements.length
+                ? entitlements.map(item => `
+                    <article class="service-card">
+                        <div class="service-head">
+                            <div>
+                                <h3>${escapeHtml(String(item.entitlement_key || '').replace(/_/g, ' '))}</h3>
+                                <p class="small">${escapeHtml(item.notes || (item.enabled ? 'Included in your current provider plan.' : 'Available as an upgrade.'))}</p>
+                            </div>
+                            <span class="status-pill">${item.enabled ? 'Included' : 'Upgrade'}</span>
+                        </div>
+                    </article>
+                `).join('')
+                : '<p class="small">No entitlement rows are configured yet.</p>';
+            document.getElementById('integrationList').innerHTML = integrations.length
+                ? integrations.map(item => `
+                    <article class="service-card">
+                        <div class="service-head">
+                            <div>
+                                <h3>${escapeHtml(item.label || item.integration_key || 'Integration')}</h3>
+                                <p class="small">${escapeHtml(item.notes || 'Integration audit is pending.')}</p>
+                            </div>
+                            <span class="status-pill">${escapeHtml(String(item.integration_status || 'no_access').replace(/_/g, ' '))}</span>
+                        </div>
+                        <div class="service-meta">
+                            <span class="status-pill">${escapeHtml(item.external_system || 'external app pending')}</span>
+                            <span class="status-pill">${escapeHtml(String(item.source_of_truth || 'unknown_pending_access').replace(/_/g, ' '))}</span>
+                        </div>
+                    </article>
+                `).join('')
+                : '<p class="small">No external app audit rows are configured yet.</p>';
+            document.getElementById('accessChecklist').innerHTML = accessChecklist.length
+                ? accessChecklist.map(item => `
+                    <article class="service-card">
+                        <div class="service-head">
+                            <div>
+                                <h3>${escapeHtml(item.label || item.item_key || 'Access item')}</h3>
+                                <p class="small">${escapeHtml(item.next_action || item.notes || 'BNA will request or confirm this before enabling sync/import automation.')}</p>
+                            </div>
+                            <span class="status-pill">${escapeHtml(String(item.status || 'needed').replace(/_/g, ' '))}</span>
+                        </div>
+                    </article>
+                `).join('')
+                : '<p class="small">No access checklist items are configured yet.</p>';
+            document.getElementById('providerActivity').innerHTML = `
+                <article class="service-card">
+                    <div class="service-head">
+                        <div>
+                            <h3>Workspace opened</h3>
+                            <p class="small">Current session loaded with ${services.length} service${services.length === 1 ? '' : 's'}.</p>
+                        </div>
+                        <span class="status-pill">${escapeHtml(new Date().toLocaleDateString('en-GB'))}</span>
+                    </div>
+                </article>
+                <div class="notice">Detailed activity logs are not configured yet. Operations admins can inspect provider changes from the admin dashboard.</div>
+            `;
+            const profileForm = document.getElementById('profileForm');
+            for (const key of ['provider_name', 'contact_name', 'contact_email', 'contact_phone', 'public_notes']) {
+                if (profileForm.elements[key]) profileForm.elements[key].value = provider[key] || '';
+            }
+            document.getElementById('serviceList').innerHTML = services.length
+                ? services.map((service) => `
+                    <article class="service-card">
+                        <div class="service-head">
+                            <div>
+                                <h3>${escapeHtml(service.title)}</h3>
+                                <p class="small">${escapeHtml(service.description || 'No description yet.')}</p>
+                            </div>
+                            <span class="status-pill">${escapeHtml(service.status || 'review')}</span>
+                        </div>
+                        <div class="service-meta">
+                            <span class="status-pill">${escapeHtml(service.service_type || 'service')}</span>
+                            <span class="status-pill">${escapeHtml(service.city || 'city tbd')}</span>
+                            <span class="status-pill">${service.price_amount ? escapeHtml(`${service.price_amount} ${service.currency || ''}`) : 'price tbd'}</span>
+                            <span class="status-pill">${service.capacity ? escapeHtml(`${service.capacity} seats`) : 'capacity tbd'}</span>
+                        </div>
+                    </article>
+                `).join('')
+                : '<p class="small">No services yet.</p>';
+            renderProviderNav();
+            setProviderSection(activeProviderSection);
+        }
+
+        async function loadSession() {
+            try {
+                renderPortal(await api('/api/provider-portal/session'));
+            } catch {
+                showLogin();
+            }
+        }
+
+        document.getElementById('loginForm').addEventListener('submit', async (event) => {
+            event.preventDefault();
+            const button = document.getElementById('loginButton');
+            button.disabled = true;
+            try {
+                const data = await api('/api/provider-portal/login', {
+                    method: 'POST',
+                    body: JSON.stringify({
+                        username: document.getElementById('username').value,
+                        password: document.getElementById('password').value
+                    })
+                });
+                renderPortal(data);
+            } catch (error) {
+                showLogin(error.message);
+            } finally {
+                button.disabled = false;
+            }
+        });
+
+        document.getElementById('logoutButton').addEventListener('click', async () => {
+            await api('/api/provider-portal/logout', { method: 'POST' }).catch(() => {});
+            showLogin();
+        });
+
+        document.getElementById('providerNav').addEventListener('click', (event) => {
+            const button = event.target.closest('[data-provider-nav]');
+            if (button) setProviderSection(button.dataset.providerNav);
+        });
+
+        document.getElementById('profileForm').addEventListener('submit', async (event) => {
+            event.preventDefault();
+            const button = event.submitter;
+            button.disabled = true;
+            try {
+                renderPortal(await api('/api/provider-portal/profile', {
+                    method: 'PATCH',
+                    body: JSON.stringify(formObject(event.currentTarget))
+                }));
+            } finally {
+                button.disabled = false;
+            }
+        });
+
+        document.getElementById('serviceForm').addEventListener('submit', async (event) => {
+            event.preventDefault();
+            const button = event.submitter;
+            button.disabled = true;
+            try {
+                renderPortal(await api('/api/provider-portal/services', {
+                    method: 'POST',
+                    body: JSON.stringify(formObject(event.currentTarget))
+                }));
+                event.currentTarget.reset();
+            } finally {
+                button.disabled = false;
+            }
+        });
+
+        loadSession();
+    </script>
+</body>
+</html>
