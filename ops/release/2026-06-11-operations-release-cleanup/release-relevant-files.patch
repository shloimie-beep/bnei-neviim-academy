+                event.preventDefault();
+                sendParentHelp(helpForm);
+                return;
+            }
+
+            const chatForm = event.target.closest('[data-parent-chat-form]');
+            if (chatForm) {
+                event.preventDefault();
+                sendParentChatMessage(chatForm);
+                return;
+            }
+
