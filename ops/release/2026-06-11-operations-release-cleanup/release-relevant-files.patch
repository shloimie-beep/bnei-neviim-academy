+function opsScopeProjectKey(req) {
+  return req?.opsIdentity?.scope?.type === 'project'
+    ? req.opsIdentity.scope.projectKey
+    : '';
+}
+
+function assertProjectAccess(req, project) {
+  const scopedProjectKey = opsScopeProjectKey(req);
+  if (!scopedProjectKey) return;
+  if (normalizeProjectKey(project?.project_key) !== scopedProjectKey) {
+    const error = new Error('This login can only access One Time Mishnah Class tasks.');
+    error.statusCode = 403;
+    throw error;
+  }
+}
+
+function normalizeWorkspaceKey(value) {
+  const normalized = String(value || '')
+    .trim()
+    .toLowerCase()
+    .replace(/['"]/g, '')
+    .replace(/&/g, ' and ')
+    .replace(/[^a-z0-9]+/g, '_')
+    .replace(/^_+|_+$/g, '');
+  if (!normalized) return '';
+  if (['platform', 'super_admin', 'superadmin', 'agency', 'ops', 'operations'].includes(normalized)) return 'platform';
+  if (['bna', 'school', 'bna_school', 'bna_school_workspace', 'bnei_neviim', 'bnei_neviim_academy', DEFAULT_PROJECT_KEY].includes(normalized)) return 'bna';
+  if (
+    [
+      'provider',
+      'one_time',
+      'one_time_mishnah',
+      'one_time_mishna',
+      'one_time_mishnah_class',
+      'one_time_mishna_class',
+      'mishnah',
+      'mishna',
+      'rabbi_elie',
+      'rabbi_elie_scheller',
+      'elie_scheller',
+      'rabbi_sheller',
+      'rabbi_sheller_provider',
+      'rabbi_scheller_provider',
+    ].includes(normalized)
+  ) {
+    return 'rabbi_sheller_provider';
+  }
+  return normalized;
+}
+
+function workspaceProjectKey(workspaceKey) {
+  const key = normalizeWorkspaceKey(workspaceKey);
+  if (key === 'bna') return DEFAULT_PROJECT_KEY;
+  if (key === 'rabbi_sheller_provider') return ONE_TIME_PROJECT_KEY;
+  return '';
+}
+
+function workspaceKeyForProject(projectKey) {
+  const key = normalizeProjectKey(projectKey);
+  if (key === ONE_TIME_PROJECT_KEY) return 'rabbi_sheller_provider';
+  if (key === DEFAULT_PROJECT_KEY) return 'bna';
+  return normalizeWorkspaceKey(key) || 'bna';
+}
+
+function defaultWorkspaceKeyForRequest(req) {
+  const scopedProjectKey = opsScopeProjectKey(req);
+  return scopedProjectKey ? workspaceKeyForProject(scopedProjectKey) : 'platform';
+}
+
+function assertWorkspaceAccess(req, workspaceKey) {
+  const key = normalizeWorkspaceKey(workspaceKey) || defaultWorkspaceKeyForRequest(req);
+  const scopedProjectKey = opsScopeProjectKey(req);
+  if (!scopedProjectKey) return key;
+  const allowedWorkspace = workspaceKeyForProject(scopedProjectKey);
+  if (key !== allowedWorkspace) {
+    const error = new Error('This login can only access its scoped provider workspace.');
+    error.statusCode = 403;
+    throw error;
+  }
+  return key;
+}
