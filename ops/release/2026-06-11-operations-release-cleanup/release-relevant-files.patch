+function findTorahSeedByName(name) {
+  const normalizedName = normalizeLooseText(name);
+  return TORAH_STUDENT_SEEDS.find((seed) =>
+    [seed.name, ...(seed.aliases || [])].some((alias) => normalizeLooseText(alias) === normalizedName)
+  ) || null;
+}
+
+function containsHebrewText(value = '') {
+  return /[\u0590-\u05ff]/.test(String(value || ''));
+}
+
+function studentLocalizedNames(student = {}) {
+  const seed = findTorahSeedByName(student.name || student.name_en || student.name_he || '');
+  const seedHebrewName = seed?.name_he || (seed?.aliases || []).find(containsHebrewText) || '';
+  const english = limitText(student.name_en || (!containsHebrewText(student.name) ? student.name : '') || seed?.name || student.name || '', 180);
+  const hebrew = limitText(student.name_he || (containsHebrewText(student.name) ? student.name : '') || seedHebrewName || '', 180);
+  return {
+    en: english || student.name || hebrew || '',
+    he: hebrew || english || student.name || '',
+  };
+}
