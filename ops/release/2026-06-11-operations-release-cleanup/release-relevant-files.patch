+            const button = form.querySelector('button[type="submit"]');
+            const fileInput = form.querySelector('input[type="file"]');
+            if (!fileInput?.files?.length) {
+                if (status) {
+                    status.textContent = t('uploadFirst');
+                    status.classList.add('error');
+                }
+                return;
+            }
+            const files = Array.from(fileInput.files || []);
+            if (button) button.disabled = true;
+            if (status) {
+                status.textContent = t('uploading');
+                status.classList.remove('error');
+            }
+            try {
+                let result = null;
+                for (const [index, file] of files.entries()) {
+                    const formData = new FormData();
+                    formData.append('meeting_date', form.querySelector('[name="meeting_date"]')?.value || '');
+                    formData.append('notes', form.querySelector('[name="notes"]')?.value || '');
+                    formData.append('recording', file, file.name);
+                    if (status) status.textContent = `${t('uploading')} ${index + 1}/${files.length}`;
+                    result = await api(`/api/parent-portal/students/${encodeURIComponent(studentId)}/meeting-recordings`, {
+                        method: 'POST',
+                        body: formData,
+                    });
+                }
+                form.reset();
+                if (status) status.textContent = result.message || t('uploadMeetingDone');
+                await loadPortal();
+            } catch (error) {
+                if (status) {
+                    status.textContent = error.message || t('uploadFirst');
+                    status.classList.add('error');
