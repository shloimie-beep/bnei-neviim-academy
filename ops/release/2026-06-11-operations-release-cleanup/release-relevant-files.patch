+                await loadPortal();
+            } catch (error) {
+                if (status) {
+                    status.textContent = error.message || t('instructionsFailed');
+                    status.classList.add('error');
+                } else {
+                    alert(error.message || t('instructionsFailed'));
+                }
+            } finally {
+                if (button) button.disabled = false;
+            }
+        }
+
+        async function uploadParentMeetingRecording(form) {
