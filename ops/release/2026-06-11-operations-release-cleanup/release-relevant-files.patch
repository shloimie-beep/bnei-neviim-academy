+
+function sourceContextToText(value) {
+  if (value === undefined || value === null || value === '') return null;
+  if (typeof value === 'string') return value;
+  return JSON.stringify(value);
+}
+
+function sefariaSearchUrl(query) {
+  const value = String(query || '').replace(/\s+/g, ' ').trim().slice(0, 180);
+  return `https://www.sefaria.org/search?q=${encodeURIComponent(value || 'halacha')}`;
+}
+
+function buildTorahResearchTaskNotes({ title, notes, rawText } = {}) {
+  const existing = String(notes || rawText || '').trim();
+  const query = [title, rawText].filter(Boolean).join(' ').replace(/\s+/g, ' ').trim();
+  const instructions = [
+    'Torah research workflow:',
+    `- Start with Sefaria search: ${sefariaSearchUrl(query || title)}`,
+    '- Use the official Sefaria search API when useful: POST https://www.sefaria.org/api/search-wrapper',
