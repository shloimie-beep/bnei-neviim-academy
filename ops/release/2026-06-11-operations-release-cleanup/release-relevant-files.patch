+  }
+  const result = await context.db.query(
+    `SELECT *
+     FROM bna_content_outputs
+     WHERE ${conditions.join(' AND ')}
+     ORDER BY updated_at DESC NULLS LAST, created_at DESC, id DESC
+     LIMIT 1`,
