{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bna.local/schemas/execution-run-requirements.schema.json",
  "title": "BNA Execution Run Requirements",
  "type": "object",
  "required": ["run_id", "title", "requirements"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "expected_result"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{8}-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string"
          },
          "parent_id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{8}-[0-9]{3}$"
          },
          "canonical_id": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "needs_verification",
              "blocked",
              "needs_operator_decision",
              "done",
              "already_satisfied",
              "verified",
              "failed",
              "archived",
              "superseded"
            ]
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "current_verdict": {
            "type": "string",
            "enum": [
              "closed_existing",
              "already_satisfied",
              "partial",
              "missing",
              "conflicting",
              "blocked",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          },
          "depends_on_audit_output": {
            "type": "boolean"
          },
          "live_required": {
            "type": "boolean"
          },
          "blocker": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deployment_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementation_commits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "files_changed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
