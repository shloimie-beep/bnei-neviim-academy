{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bna.local/schemas/execution-run-requirements.schema.json",
  "title": "BNA Execution Run Requirements",
  "type": "object",
  "required": ["run_id", "title", "requirements"],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string"
    },
    "git_refs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "expected_branch": { "type": "string" },
        "branch": { "type": "string" },
        "current_branch": { "type": "string" },
        "expected_head": { "type": "string" },
        "head": { "type": "string" },
        "current_head": { "type": "string" },
        "expected_remote_head": { "type": "string" },
        "remote_head": { "type": "string" },
        "current_remote_head": { "type": "string" },
        "pr_number": { "type": ["integer", "string"] },
        "pr_url": { "type": "string" },
        "pr_branch": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "captured_at",
          "content_fingerprint",
          "privacy_classification",
          "workspace",
          "project",
          "source_type"
        ],
        "additionalProperties": true,
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string" },
          "connector_id": { "type": "string" },
          "captured_at": { "type": "string", "minLength": 1 },
          "content_fingerprint": { "type": "string", "minLength": 1 },
          "privacy_classification": { "type": "string", "minLength": 1 },
          "workspace": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "source_type": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["source_path"] },
          { "required": ["connector_id"] }
        ]
      }
    },
    "source_statements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["statement_id", "source_statement"],
        "properties": {
          "statement_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string" },
          "source_statement": { "type": "string", "minLength": 1 },
          "requirement_id": { "type": "string" },
          "existing_requirement_id": { "type": "string" },
          "mapped_requirement_id": { "type": "string" },
          "classification": { "type": "string" },
          "mapping_classification": { "type": "string" }
        }
      }
    },
    "source_statement_matrix": {
      "type": ["string", "object"]
    },
    "source_statement_matrices": {
      "type": "array",
      "items": {
        "type": ["string", "object"]
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "expected_result"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{8}-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "needs_verification",
              "blocked",
              "needs_operator_decision",
              "done",
              "already_satisfied",
              "verified",
              "failed",
              "archived",
              "superseded"
            ]
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "depends_on_audit_output": {
            "type": "boolean"
          },
          "live_required": {
            "type": "boolean"
          },
          "blocker": {
            "type": "string"
          },
          "blocker_owner": {
            "type": "string"
          },
          "blocker_next_action": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deployment_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementation_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
