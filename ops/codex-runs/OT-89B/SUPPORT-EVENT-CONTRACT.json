{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ot89:contract:onetime-bna-subscriber-support-event:1.0.0",
  "title": "OT89 One Time subscriber support event",
  "description": "Frozen v1 contract for an authenticated active One Time subscriber support submission. The event contains sanitized user-supplied text and private attachment locators; it never contains attachment bytes, public attachment URLs, direct contact details, credentials, or session tokens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_type",
    "event_id",
    "occurred_at",
    "producer",
    "submission",
    "actor",
    "authorization",
    "ticket",
    "attachments",
    "privacy",
    "trace"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "event_type": {
      "const": "onetime.support.ticket.submitted.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Stable across all delivery retries. Generated once when the durable outbox row is committed."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "environment",
        "deployment_id",
        "source_commit"
      ],
      "properties": {
        "service": {
          "const": "onetime"
        },
        "environment": {
          "enum": [
            "development",
            "staging",
            "production"
          ]
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ticket_id",
        "receipt_id",
        "outbox_id"
      ],
      "properties": {
        "source_ticket_id": {
          "type": "string",
          "pattern": "^ots_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^otr_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "outbox_id": {
          "type": "string",
          "pattern": "^otx_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onetime_user_id",
        "onetime_account_id"
      ],
      "properties": {
        "onetime_user_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$"
        },
        "onetime_account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "authenticated",
        "account_id",
        "entitlement_product",
        "entitlement_id",
        "entitlement_status",
        "checked_at",
        "valid_until"
      ],
      "properties": {
        "policy_version": {
          "const": "ot89-subscriber-support-v1"
        },
        "authenticated": {
          "const": true
        },
        "account_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$"
        },
        "entitlement_product": {
          "const": "one_time"
        },
        "entitlement_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$"
        },
        "entitlement_status": {
          "const": "active"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null is valid for a non-expiring active entitlement."
        }
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "title",
        "message",
        "issue_details",
        "client_context",
        "reply_preference"
      ],
      "properties": {
        "category": {
          "enum": [
            "bug",
            "access_login",
            "class_zoom",
            "billing",
            "content",
            "complaint",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 20,
          "maxLength": 6000
        },
        "reply_preference": {
          "enum": [
            "in_app",
            "email",
            "whatsapp"
          ]
        },
        "issue_details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps_to_reproduce",
            "expected_behavior",
            "actual_behavior",
            "occurrence",
            "first_observed_at",
            "error_code",
            "provider"
          ],
          "properties": {
            "steps_to_reproduce": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "expected_behavior": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                },
                {
                  "type": "null"
                }
              ]
            },
            "actual_behavior": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                },
                {
                  "type": "null"
                }
              ]
            },
            "occurrence": {
              "enum": [
                "once",
                "intermittent",
                "always",
                "not_applicable"
              ]
            },
            "first_observed_at": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            },
            "error_code": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,99}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provider": {
              "enum": [
                "none",
                "authentication",
                "zoom",
                "payments",
                "content_delivery",
                "other"
              ]
            }
          }
        },
        "client_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route_template",
            "app_release",
            "locale",
            "timezone"
          ],
          "properties": {
            "route_template": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./\\[\\]-]{0,255}$",
              "description": "A normalized route template only. Query strings, fragments, user IDs, emails, and arbitrary URLs are forbidden."
            },
            "app_release": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "locale": {
              "type": "string",
              "minLength": 2,
              "maxLength": 35
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachment_id",
          "normalized_filename",
          "media_type",
          "size_bytes",
          "sha256",
          "transfer_locator",
          "normalization",
          "storage_class",
          "content_disposition"
        ],
        "properties": {
          "attachment_id": {
            "type": "string",
            "pattern": "^ota_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "normalized_filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^/\\\\\\u0000-\\u001F\\u007F]+$"
          },
          "media_type": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "text/plain"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "transfer_locator": {
            "type": "string",
            "pattern": "^onetime-private-blob://ota_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "normalization": {
            "enum": [
              "image-decoded-and-reencoded",
              "utf8-text-normalized"
            ]
          },
          "storage_class": {
            "const": "private"
          },
          "content_disposition": {
            "const": "attachment"
          },
          "pixel_width": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 8000
              },
              {
                "type": "null"
              }
            ]
          },
          "pixel_height": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 8000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "media_type": {
                  "const": "text/plain"
                }
              }
            },
            "then": {
              "properties": {
                "size_bytes": {
                  "maximum": 1048576
                },
                "normalization": {
                  "const": "utf8-text-normalized"
                },
                "pixel_width": {
                  "type": "null"
                },
                "pixel_height": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "normalization": {
                  "const": "image-decoded-and-reencoded"
                },
                "pixel_width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8000
                },
                "pixel_height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8000
                }
              },
              "required": [
                "pixel_width",
                "pixel_height"
              ]
            }
          }
        ]
      },
      "description": "The producer must also enforce a 10 MiB aggregate size limit and a 20 megapixel decoded-image limit."
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redaction_policy",
        "content_state",
        "contains_raw_secrets",
        "contains_direct_contact_details",
        "redacted_fields",
        "redaction_count"
      ],
      "properties": {
        "redaction_policy": {
          "const": "ot89-redaction-v1"
        },
        "content_state": {
          "const": "sanitized_user_text"
        },
        "contains_raw_secrets": {
          "const": false
        },
        "contains_direct_contact_details": {
          "const": false
        },
        "redacted_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ticket.title",
              "ticket.message",
              "ticket.issue_details.steps_to_reproduce",
              "ticket.issue_details.expected_behavior",
              "ticket.issue_details.actual_behavior",
              "attachments.normalized_filename"
            ]
          }
        },
        "redaction_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id",
        "request_id"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$"
        }
      }
    }
  },
