  "examples": [
    {
      "contract_version": "1.0.0",
      "event_type": "onetime.support.ticket.submitted.v1",
      "event_id": "evt_01J00000000000000000000000",
      "occurred_at": "2026-07-15T12:00:00Z",
      "producer": {
        "service": "onetime",
        "environment": "staging",
        "deployment_id": "staging-20260715-1200",
        "source_commit": "0123456789abcdef0123456789abcdef01234567"
      },
      "submission": {
        "source_ticket_id": "ots_01J00000000000000000000001",
        "receipt_id": "otr_01J00000000000000000000002",
        "outbox_id": "otx_01J00000000000000000000003"
      },
      "actor": {
        "onetime_user_id": "usr_demo_000001",
        "onetime_account_id": "acct_demo_000001"
      },
      "authorization": {
        "policy_version": "ot89-subscriber-support-v1",
        "authenticated": true,
        "account_id": "acct_demo_000001",
        "entitlement_product": "one_time",
