{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bneineviimacademy.org/schemas/intent-preservation.schema.json",
  "title": "BNA Intent Preservation Atomic Specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "spec_id",
    "raw",
    "scope",
    "global_invariants",
    "changes",
    "source_coverage",
    "readiness",
    "fingerprint"
  ],
  "properties": {
    "spec_version": { "const": "intent-preservation-v1" },
    "spec_id": { "type": "string", "pattern": "^SPEC-[0-9]{8}-[0-9]{3,}$" },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_id", "path", "capture_mode", "sha256", "character_count"],
      "properties": {
        "raw_id": { "type": "string", "pattern": "^RAW-[0-9]{8}-[0-9]{3,}$" },
        "path": { "type": "string", "minLength": 1 },
        "capture_mode": { "const": "verbatim" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "character_count": { "type": "integer", "minimum": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "project", "routes"],
      "properties": {
        "workspace": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "routes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "global_invariants": {
      "type": "array",
      "items": { "$ref": "#/$defs/invariant" }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "source_coverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceCoverage" }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocking_change_ids"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "needs_clarification", "ready_for_pqc", "ready_for_implementation"]
        },
        "blocking_change_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "start", "end", "quote"],
      "properties": {
        "span_id": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "quote": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "component", "selector", "accessible_name", "current_text_anchor"],
      "properties": {
        "section": { "type": "string" },
        "component": { "type": "string" },
        "selector": { "type": "string" },
        "accessible_name": { "type": "string" },
        "current_text_anchor": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "sibling_before", "sibling_after", "order"],
      "properties": {
        "parent": { "type": "string" },
        "sibling_before": { "type": "string" },
        "sibling_after": { "type": "string" },
        "order": { "type": "array", "items": { "type": "string" } }
      }
    },
    "styleScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_targets", "forbidden_targets", "properties"],
      "properties": {
        "allowed_targets": { "type": "array", "items": { "type": "string" } },
        "forbidden_targets": { "type": "array", "items": { "type": "string" } },
        "properties": { "type": "array", "items": { "type": "string" } }
      }
    },
    "viewportBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewport", "assertion"],
      "properties": {
        "viewport": { "type": "string" },
        "assertion": { "type": "string" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "text"],
      "properties": {
        "assertion_id": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
        "negative": { "type": "array", "items": { "$ref": "#/$defs/assertion" } }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflicting_change_id", "field", "resolution", "superseded_by"],
      "properties": {
        "conflicting_change_id": { "type": "string" },
        "field": { "type": "string" },
        "resolution": { "type": "string" },
        "superseded_by": { "type": "string" }
      }
    },
    "resolutionQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "choices"],
      "properties": {
        "question": { "type": "string" },
        "choices": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "description", "recommended"],
            "properties": {
              "label": { "type": "string" },
              "description": { "type": "string" },
              "recommended": { "type": "boolean" }
            }
          }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "source_spans",
        "classification",
        "provenance",
        "confidence",
        "ambiguity_status",
        "route",
        "screen",
        "target",
        "primary_operation",
        "current_state",
        "required_state",
        "exact_payload",
        "layout",
        "style_scope",
        "viewport_behavior",
        "must_preserve",
        "must_remove",
        "conflicts",
        "supersedes_ids",
        "acceptance_assertions",
        "dependencies",
        "resolution_question"
      ],
      "properties": {
        "change_id": { "type": "string", "pattern": "^CHG-[0-9]{8}-[0-9]{3,}$" },
        "source_spans": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceSpan" } },
        "classification": { "type": "string", "enum": ["HARD_EXACT", "SOFT_GOAL", "AMBIGUOUS", "NON_ACTIONABLE"] },
        "provenance": { "type": "string", "enum": ["USER_STATED", "AGENT_INFERRED"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "ambiguity_status": { "type": "string", "enum": ["none", "resolved", "unresolved"] },
        "route": { "type": "string" },
        "screen": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "primary_operation": { "type": "string", "enum": ["add", "replace", "remove", "move", "style", "preserve", "behavior"] },
        "current_state": { "type": "string" },
        "required_state": { "type": "string" },
        "exact_payload": { "type": "object", "additionalProperties": true },
        "layout": { "$ref": "#/$defs/layout" },
        "style_scope": { "$ref": "#/$defs/styleScope" },
        "viewport_behavior": { "type": "array", "items": { "$ref": "#/$defs/viewportBehavior" } },
        "must_preserve": { "type": "array", "items": { "type": "string" } },
        "must_remove": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
        "supersedes_ids": { "type": "array", "items": { "type": "string" } },
        "acceptance_assertions": { "$ref": "#/$defs/assertions" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "resolution_question": { "$ref": "#/$defs/resolutionQuestion" }
      }
    },
    "invariant": {
      "allOf": [
        { "$ref": "#/$defs/change" }
      ]
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_id",
        "span_id",
        "start",
        "end",
        "quote",
        "classification",
        "coverage_status",
        "change_id",
        "global_invariant_id",
        "reason"
      ],
      "properties": {
        "coverage_id": { "type": "string" },
        "span_id": { "type": "string" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "quote": { "type": "string" },
        "classification": { "type": "string", "enum": ["HARD_EXACT", "SOFT_GOAL", "AMBIGUOUS", "NON_ACTIONABLE"] },
        "coverage_status": { "type": "string", "enum": ["covered", "ambiguous", "non_actionable"] },
        "change_id": { "type": ["string", "null"] },
        "global_invariant_id": { "type": ["string", "null"] },
        "reason": { "type": "string" }
      }
    }
  }
}
