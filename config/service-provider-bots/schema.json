{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bna.provider_lead_bot.v1",
  "title": "BNA service-provider lead bot profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_key",
    "version",
    "scope",
    "identity",
    "personality",
    "goals",
    "offer",
    "knowledge_base",
    "lead_capture",
    "routing",
    "policies"
  ],
  "properties": {
    "schema_version": { "const": "bna.provider_lead_bot.v1" },
    "profile_key": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["workspace_key", "project_key", "channels"],
      "properties": {
        "workspace_key": { "type": "string", "minLength": 1 },
        "project_key": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["communication_agent", "whatsapp", "email"] },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["whatsapp", "email", "telegram", "website"] },
          "uniqueItems": true
        },
        "audience": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["assistant_name", "assistant_subtitle", "human_disclosure_required", "may_impersonate_owner"],
      "properties": {
        "assistant_name": { "type": "string", "minLength": 1 },
        "assistant_subtitle": { "type": "string", "minLength": 1 },
        "owner_name": { "type": "string" },
        "human_disclosure_required": { "const": true },
        "may_impersonate_owner": { "const": false }
      }
    },
    "personality": {
      "type": "object",
      "required": ["tone", "style_rules", "boundaries"],
      "properties": {
        "tone": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "style_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "agent_model": {
      "type": "object",
      "required": ["model_family", "agent_key", "publication_status", "shared_knowledge_snapshot", "build_qa_agent"],
      "properties": {
        "model_family": { "const": "communication_agent" },
        "agent_key": { "type": "string", "minLength": 1 },
        "publication_status": { "enum": ["draft", "published", "paused"] },
        "shared_knowledge_snapshot": { "const": true },
        "build_qa_agent": { "const": false },
        "description": { "type": "string" }
      }
    },
    "channel_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "channel_id",
          "channel",
          "provider",
          "agent_version",
          "knowledge_snapshot_ref",
          "reply_mode",
          "create_contact_on_inbound",
          "create_conversation_on_inbound",
          "create_task_on_inbound",
          "active",
          "formatting_policy"
        ],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "channel": { "enum": ["whatsapp", "email", "telegram", "website"] },
          "provider": { "type": "string", "minLength": 1 },
          "agent_version": { "type": "string", "minLength": 1 },
          "knowledge_snapshot_ref": { "type": "string", "minLength": 1 },
          "reply_mode": { "enum": ["off", "capture_only", "draft", "live"] },
          "outbox_channel_key": { "type": ["string", "null"] },
          "create_contact_on_inbound": { "type": "boolean" },
          "create_conversation_on_inbound": { "type": "boolean" },
          "create_task_on_inbound": { "type": "boolean" },
          "human_handoff_mode": { "type": "string" },
          "active": { "type": "boolean" },
          "formatting_policy": { "type": "object" }
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["priority", "key", "instruction"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "key": { "type": "string", "minLength": 1 },
          "instruction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "offer": {
      "type": "object",
      "required": ["trial_days", "renewal", "bot_may_charge", "bot_may_grant_access"],
      "properties": {
        "trial_days": { "type": "integer", "minimum": 0 },
        "renewal": {
          "type": "object",
          "required": ["amount", "currency", "cadence"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "cadence": { "type": "string", "minLength": 1 }
          }
        },
        "bot_may_charge": { "const": false },
        "bot_may_grant_access": { "const": false }
      }
    },
    "knowledge_base": { "type": "object" },
    "lead_capture": { "type": "object" },
    "routing": { "type": "object" },
    "policies": { "type": "object" }
  }
}
