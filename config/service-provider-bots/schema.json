{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bna.provider_lead_bot.v1",
  "title": "BNA service-provider lead bot profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_key",
    "version",
    "scope",
    "identity",
    "personality",
    "goals",
    "offer",
    "knowledge_base",
    "lead_capture",
    "routing",
    "policies"
  ],
  "properties": {
    "schema_version": { "const": "bna.provider_lead_bot.v1" },
    "profile_key": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["workspace_key", "project_key", "channel"],
      "properties": {
        "workspace_key": { "type": "string", "minLength": 1 },
        "project_key": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["whatsapp"] }
      }
    },
    "identity": {
      "type": "object",
      "required": ["assistant_name", "assistant_subtitle", "human_disclosure_required", "may_impersonate_owner"],
      "properties": {
        "assistant_name": { "type": "string", "minLength": 1 },
        "assistant_subtitle": { "type": "string", "minLength": 1 },
        "owner_name": { "type": "string" },
        "human_disclosure_required": { "const": true },
        "may_impersonate_owner": { "const": false }
      }
    },
    "personality": {
      "type": "object",
      "required": ["tone", "style_rules", "boundaries"],
      "properties": {
        "tone": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "style_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["priority", "key", "instruction"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "key": { "type": "string", "minLength": 1 },
          "instruction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "offer": {
      "type": "object",
      "required": ["trial_days", "renewal", "bot_may_charge", "bot_may_grant_access"],
      "properties": {
        "trial_days": { "type": "integer", "minimum": 0 },
        "renewal": {
          "type": "object",
          "required": ["amount", "currency", "cadence"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "cadence": { "type": "string", "minLength": 1 }
          }
        },
        "bot_may_charge": { "const": false },
        "bot_may_grant_access": { "const": false }
      }
    },
    "knowledge_base": { "type": "object" },
    "lead_capture": { "type": "object" },
    "routing": { "type": "object" },
    "policies": { "type": "object" }
  }
}
