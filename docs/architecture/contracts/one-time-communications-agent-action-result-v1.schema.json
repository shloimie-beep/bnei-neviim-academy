{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bneineviimacademy.org/schemas/one-time-communications-agent-action-result-v1.schema.json",
  "title": "One Time Communications Agent Action Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "job_id",
    "job_source_sha",
    "status",
    "summary",
    "evidence",
    "readback_verified",
    "external_mutations",
    "production_deployed",
    "bna_school_architecture_preserved"
  ],
  "properties": {
    "schema_version": { "const": "one-time-communications-agent-action-result-v1" },
    "result_id": { "type": "string", "pattern": "^AAR-[A-Z0-9][A-Z0-9._-]{2,127}$" },
    "job_id": { "type": "string", "pattern": "^AA-[A-Z0-9][A-Z0-9._-]{2,127}$" },
    "job_source_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "status": { "enum": ["saved", "blocked", "failed", "verified"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "readback_verified": { "type": "boolean" },
    "external_mutations": {
      "type": "array",
      "maxItems": 0,
      "items": false
    },
    "production_deployed": { "const": false },
    "bna_school_architecture_preserved": { "const": true },
    "blocker": { "type": ["string", "null"], "maxLength": 2000 },
    "next_action": { "type": ["string", "null"], "maxLength": 2000 }
  }
}
