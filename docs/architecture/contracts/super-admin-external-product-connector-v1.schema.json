{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bneineviimacademy.org/schemas/super-admin-external-product-connector-v1.schema.json",
  "title": "Super Admin External Product Connector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "connector_id",
    "label",
    "connector_type",
    "workspace_key",
    "project_key",
    "platform_owner",
    "product_repository",
    "sources_of_truth",
    "bna_school_boundary",
    "human_routing",
    "record_routes",
    "telegram_contract",
    "write_policy"
  ],
  "properties": {
    "schema_version": { "const": "super-admin-external-product-connector-v1" },
    "decision_id": { "type": "string", "pattern": "^DEC-[0-9]{8}-[0-9]{3,}$" },
    "connector_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "connector_type": { "const": "external_product_connector" },
    "workspace_key": { "type": "string", "minLength": 1 },
    "project_key": { "type": "string", "minLength": 1 },
    "platform_owner": { "const": "platform_control" },
    "product_repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "sources_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_communications",
        "product_accounts",
        "rabbi_interface",
        "security_token_email"
      ],
      "properties": {
        "customer_communications": { "$ref": "#/$defs/sourceOfTruth" },
        "product_accounts": { "$ref": "#/$defs/sourceOfTruth" },
        "rabbi_interface": { "$ref": "#/$defs/sourceOfTruth" },
        "security_token_email": { "$ref": "#/$defs/sourceOfTruth" }
      }
    },
    "bna_school_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_key", "crm_source_of_truth", "ghl_exception_applies", "architecture_preserved"],
      "properties": {
        "workspace_key": { "const": "bna_school" },
        "crm_source_of_truth": { "const": "first_party_bna_operations" },
        "ghl_exception_applies": { "const": false },
        "architecture_preserved": { "const": true }
      }
    },
    "human_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_inbound_owner", "rabbi_recipient", "rabbi_allowlist", "rabbi_denylist", "ai_torah_answer_policy"],
      "properties": {
        "default_inbound_owner": { "const": "Shloimie" },
        "rabbi_recipient": { "const": "Rabbi Eli" },
        "rabbi_allowlist": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "assigned_substantive_torah_mishnah_halachic_question",
              "rabbi_authored_newsletter_content_draft",
              "approved_warm_enrollment_draft"
            ]
          }
        },
        "rabbi_denylist": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "login",
              "billing",
              "support",
              "scheduling",
              "parent_administration",
              "unknown_general"
            ]
          }
        },
        "ai_torah_answer_policy": { "const": "must_not_originate_in_rabbi_name" }
      }
    },
    "record_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live_class_question", "business_conversation", "technical_ticket"],
      "properties": {
        "live_class_question": { "$ref": "#/$defs/recordRoute" },
        "business_conversation": { "$ref": "#/$defs/recordRoute" },
        "technical_ticket": { "$ref": "#/$defs/recordRoute" }
      }
    },
    "telegram_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_transcript", "interface_for", "ghl_write_required_for", "ai_may_originate_torah_answer"],
      "properties": {
        "canonical_transcript": { "const": false },
        "interface_for": { "const": "assigned_rabbi_torah_and_content_work" },
        "ghl_write_required_for": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["send", "draft", "status_change"] }
        },
        "ai_may_originate_torah_answer": { "const": false }
      }
    },
    "write_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_mutations_authorized", "email_send", "telegram_send", "ghl_mutation", "dns_change", "production_deployment"],
      "properties": {
        "external_mutations_authorized": { "const": false },
        "email_send": { "const": false },
        "telegram_send": { "const": false },
        "ghl_mutation": { "const": false },
        "dns_change": { "const": false },
        "production_deployment": { "const": false }
      }
    }
  },
  "$defs": {
    "sourceOfTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "authority", "canonical"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "canonical": { "type": "boolean" },
        "allowed_purposes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "recordRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "owner", "canonical_system", "bna_ticket_queue"],
      "properties": {
        "record_type": { "enum": ["live_class_question", "business_conversation", "technical_ticket"] },
        "owner": { "enum": ["one_time", "highlevel", "platform_control"] },
        "canonical_system": { "enum": ["one_time_app", "highlevel", "platform_control"] },
        "bna_ticket_queue": { "const": false },
        "source_workspace_required": { "type": "boolean" },
        "allowed_source_workspaces": {
          "type": "array",
          "items": { "enum": ["bna_school", "one_time"] },
          "uniqueItems": true
        }
      }
    }
  }
}
